---
import { createHash } from 'node:crypto';
import '@fontsource-variable/archivo';
import '@fontsource/archivo-black';
import '../styles/global.css';
import { address, assets, brand, company, contact, launch, seo } from '../data/site';
import themeInitSource from '../scripts/theme-init.js?raw';

interface Props {
  title?: string;
  description?: string;
}

const { title = seo.title, description = seo.description } = Astro.props;

// O script do tema roda inline no <head>, antes da primeira pintura, e o Astro
// não calcula hash para a CSP de script `is:inline`. O hash sai do mesmo texto
// que vai para a página, então editar theme-init.js não quebra a política.
// As quebras de linha viram LF antes, porque é assim que o navegador lê o HTML:
// um checkout com CRLF no Windows daria um hash que o navegador não reconhece.
const themeInit = themeInitSource.replace(/\r\n?/g, '\n');
Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(themeInit).digest('base64')}`);

// Astro.site só existe depois que `site` for preenchido em astro.config.mjs.
// Até lá, essas tags saem sem URL absoluta em vez de apontar para localhost.
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : null;
const ogImageUrl = seo.ogImage && Astro.site ? new URL(seo.ogImage, Astro.site) : null;

const absolute = (path: string) => (Astro.site ? new URL(path, Astro.site).toString() : null);
const logoUrl = absolute('/logo-mirante.svg');
const facadeUrl = assets.facade ? absolute(assets.facade) : null;

// Os dados daqui precisam bater com o Google Business Profile — endereço,
// telefone, horário e pino. Divergência entre os dois enfraquece a busca local.
const localBusiness = {
  '@context': 'https://schema.org',
  // Espelha a categoria do Google Business Profile, que hoje é "Loja de roupa".
  // Se a categoria do perfil mudar, este tipo muda junto.
  '@type': 'ClothingStore',
  name: brand.name,
  slogan: brand.slogan,
  description: seo.description,
  telephone: `+${contact.whatsappDigits}`,
  address: {
    '@type': 'PostalAddress',
    // O bairro vai na linha da rua, como no perfil do Google; a localidade é só a cidade.
    streetAddress: `${address.street} - ${address.district}`,
    addressLocality: address.city,
    addressRegion: address.state,
    postalCode: address.zip,
    addressCountry: 'BR',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: address.geo.latitude,
    longitude: address.geo.longitude,
  },
  hasMap: address.mapsProfileUrl,
  sameAs: [brand.instagramUrl],
  ...(company.openingHours
    ? {
        openingHoursSpecification: {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: company.openingHoursSpec.days,
          opens: company.openingHoursSpec.opens,
          closes: company.openingHoursSpec.closes,
        },
      }
    : {}),
  ...(company.legalName ? { legalName: company.legalName } : {}),
  ...(company.cnpj ? { taxID: company.cnpj } : {}),
  ...(contact.email ? { email: contact.email } : {}),
  ...(canonicalUrl ? { url: canonicalUrl.toString() } : {}),
  ...(logoUrl ? { logo: logoUrl } : {}),
  ...(facadeUrl ? { image: facadeUrl } : {}),
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    {
      launch.isLive ? (
        <meta name="robots" content="index, follow" />
      ) : (
        // Site ainda não lançado: nenhuma página deve ser indexada.
        // Ver `launch.isLive` em src/data/site.ts para ligar no dia do lançamento.
        <meta name="robots" content="noindex, nofollow" />
      )
    }

    {canonicalUrl && <link rel="canonical" href={canonicalUrl.toString()} />}

    <meta name="theme-color" content="#0a2c85" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={brand.name} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl.toString()} />}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl.toString()} />}

    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl.toString()} />}

    <!-- A águia sobre fundo branco: solta, ela sumia em aba escura. O original
         (a cabeça da águia, rasterizada em 195×68) fica em design/favicon-original/. -->
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
    <script is:inline set:html={themeInit} />
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/animations';
    </script>
  </body>
</html>
