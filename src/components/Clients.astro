---
import { clients } from '../data/site';

// Enquanto não houver autorização e arquivos dos logos, a esteira roda com placeholders.
const placeholders = Array.from({ length: 8 }, (_, index) => ({
  name: '',
  logo: '',
  key: `placeholder-${index}`,
}));

const items = clients.length > 0 ? clients : placeholders;
const track = [...items, ...items];
---

<section class="clients" id="clientes">
  <div class="container clients__intro">
    <span class="eyebrow" data-anim="up">Quem veste Mirante</span>
    <h2 class="title-md" data-anim="up">Clientes que confiam na qualidade <span class="highlight">Mirante</span></h2>
    <p class="lead" data-anim="up">
      Escolas, indústrias, restaurantes e comércios que vestem Mirante.
    </p>
  </div>

  <div class="marquee" data-marquee="rtl">
    <ul class="marquee__track" data-marquee-track>
      {track.map((item, index) => (
        <li class="clients__plate" aria-hidden={index >= items.length ? 'true' : undefined}>
          {item.logo ? (
            <img src={item.logo} alt={item.name} loading="lazy" decoding="async" />
          ) : (
            <span class="clients__placeholder">[Logo cliente]</span>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* A esteira de clientes é a faixa que quebra a sequência de seções brancas
     do meio da página: hero, técnicas e produtos vêm todos sobre --surface, e
     sem uma troca de cor aqui o olho perde onde uma acaba e a outra começa.
     Por ser faixa, o espaço interno é --band-pad, como no FAQ e no rodapé. */
  .clients {
    padding-block: var(--band-pad);
    background: var(--surface-2);
    overflow: hidden;
  }

  .clients__intro {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 700px;
    margin-bottom: var(--intro-gap);
  }

  /* Ver Showcase.astro: clipe só horizontal, para a sombra das placas não ser
     cortada por uma linha reta no rodapé da esteira. */
  .marquee {
    position: relative;
    padding-block: 6px;
    overflow-x: clip;
    overflow-y: visible;
  }

  .marquee__track {
    display: flex;
    gap: 16px;
    width: max-content;
    will-change: transform;
  }

  .clients__plate {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 168px;
    height: 96px;
    padding: 18px;
    /* Sobre a faixa, a placa precisa ser a camada de cima: --card é branco no
       claro e clareia no escuro, então o logo fica sempre sobre um fundo
       limpo, que é como logo de cliente deve aparecer. */
    background: var(--card);
    border-radius: 18px;
  }

  /* No escuro a placa continua clara. Logo de cliente é desenhada para fundo
     claro: sobre a placa escura, as letras azul-marinho da CPC sumiam, e a
     trama de pontos embutida no arquivo dela virava um retângulo pontilhado.
     O tom é um pouco abaixo do branco para não ofuscar na faixa escura. */
  :global(html[data-theme='dark']) .clients__plate {
    background: #e9edf5;
  }

  .clients__plate img {
    max-height: 100%;
    object-fit: contain;
  }

  .clients__placeholder {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint-2);
  }

  @media (min-width: 768px) {
    .marquee__track {
      gap: 24px;
    }

    .clients__plate {
      width: 216px;
      height: 120px;
    }
  }
</style>
