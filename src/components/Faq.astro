---
import { faq } from '../data/site';
---

<section class="faq" id="duvidas">
  <div class="container faq__inner">
    <div class="faq__intro">
      <span class="eyebrow" data-anim="up">Dúvidas frequentes</span>
      <h2 class="title-md" data-anim="up">O que mais respondemos dos nossos clientes</h2>

      {/* Preenche o vazio da coluna da esquerda, que fica ao lado da lista
          comprida. Só no desktop: no celular as colunas se empilham e ele
          só afastaria a lista do título. É enfeite, e sai do leitor de tela. */}
      <svg class="faq__mark" data-anim="up" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="12" cy="12" r="11.5" class="faq__mark-disc"></circle>
        <path
          class="faq__mark-glyph"
          d="M9.1 9.3a3 3 0 0 1 5.8 1c0 2-2.9 2.5-2.9 4.3"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
        <path class="faq__mark-glyph" d="M12 17.8h.01" stroke-width="2.4" stroke-linecap="round"></path>
      </svg>
    </div>

    <!-- Sem JavaScript todas as respostas ficam visíveis; o script fecha as demais. -->
    <ul class="faq__list" data-faq>
      {faq.map((item, index) => (
        <li class="faq__item">
          <h3 class="faq__heading">
            <button
              type="button"
              class="faq__trigger"
              id={`faq-trigger-${index}`}
              aria-expanded="true"
              aria-controls={`faq-panel-${index}`}
              data-faq-trigger
            >
              <span>{item.question}</span>
              <span class="faq__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                  <path d="M5 12h14"></path>
                  <path class="faq__icon-bar" d="M12 5v14"></path>
                </svg>
              </span>
            </button>
          </h3>
          <div
            class="faq__panel"
            id={`faq-panel-${index}`}
            role="region"
            aria-labelledby={`faq-trigger-${index}`}
            data-faq-panel
          >
            <p class="faq__answer">{item.answer}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .faq {
    padding-block: var(--band-pad);
    background: var(--surface-2);
  }

  .faq__inner {
    display: grid;
    gap: 36px;
    align-items: start;
  }

  .faq__intro {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .faq__mark {
    display: none;
  }

  .faq__mark-disc {
    fill: var(--accent-wash);
  }

  .faq__mark-glyph {
    stroke: var(--accent);
  }

  .faq__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .faq__item {
    background: var(--card);
    border-radius: 18px;
    overflow: hidden;
  }

  .faq__heading {
    margin: 0;
    font-size: inherit;
  }

  .faq__trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    width: 100%;
    padding: 20px 18px;
    background: none;
    border: 0;
    font-family: inherit;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.35;
    text-align: left;
    color: var(--heading);
    cursor: pointer;
  }

  .faq__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--faint-2);
    transition: color 0.18s ease;
  }

  .faq__icon svg {
    width: 22px;
    height: 22px;
  }

  .faq__trigger[aria-expanded='true'] .faq__icon {
    color: var(--accent);
  }

  .faq__icon-bar {
    transform-origin: center;
  }

  .faq__panel {
    overflow: hidden;
  }

  .faq__answer {
    padding: 0 18px 20px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--muted);
  }

  @media (min-width: 480px) {
    .faq__trigger {
      gap: 20px;
      padding: 22px 24px;
    }

    .faq__answer {
      padding: 0 24px 24px;
    }
  }

  @media (min-width: 768px) {
    .faq__trigger {
      padding: 26px 32px;
      font-size: 19px;
    }

    .faq__answer {
      padding: 0 32px 28px;
      font-size: 17px;
    }
  }

  @media (min-width: 1080px) {
    .faq__inner {
      grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
      gap: 80px;
    }

    .faq__mark {
      display: block;
      width: min(260px, 80%);
      height: auto;
      margin-top: 28px;
    }
  }
</style>
