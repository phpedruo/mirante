---
import { address, assets, company, contact } from '../data/site';

const mapsEmbed = `https://www.google.com/maps?q=${address.mapsQuery}&output=embed`;
const mapsLink = `https://www.google.com/maps/dir/?api=1&destination=${address.mapsQuery}`;
---

<section class="location frestas frestas--left" id="localizacao">
  <div class="container location__inner">
    <div class="location__content">
      <div class="location__head">
        <span class="eyebrow" data-anim="up">Onde estamos</span>
        <h2 class="title-md" data-anim="up">Visite a nossa fábrica e veja as peças de perto</h2>
        <p class="lead" data-anim="up">
          Tem amostra pronta no balcão para você sentir a malha e o acabamento antes de fechar o
          pedido.
        </p>
      </div>

      <div class="location__card" data-anim="up">
        {assets.facade && (
          <img
            class="location__photo"
            src={assets.facade}
            alt="Fachada da fábrica da Mirante, com o letreiro azul e laranja e as portas azuis com a águia da marca"
            loading="lazy"
            decoding="async"
            width="680"
            height="463"
          />
        )}

        <div class="location__row">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 10.5c0 5.5-8 12-8 12s-8-6.5-8-12a8 8 0 0 1 16 0z"></path>
            <circle cx="12" cy="10.5" r="2.8"></circle>
          </svg>
          <div>
            <span class="location__label">Endereço</span>
            <address class="location__value">
              {address.street}<br />
              {address.district}, {address.city} – {address.state},{' '}
              <span class="location__zip">{address.zip}</span>
            </address>
          </div>
        </div>

        <div class="location__row">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15.5v3a2 2 0 0 1-2.2 2 19.5 19.5 0 0 1-8.5-3 19 19 0 0 1-6-6 19.5 19.5 0 0 1-3-8.6A2 2 0 0 1 3.3 1h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L7.2 9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2z"></path>
          </svg>
          <div>
            <span class="location__label">WhatsApp</span>
            <a class="location__value location__phone" href={contact.whatsappUrl()} target="_blank" rel="noopener">
              {contact.whatsappDisplay}
            </a>
          </div>
        </div>

        {company.openingHours && (
          <div class="location__row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M12 6.5V12l3.5 2"></path>
            </svg>
            <div>
              <span class="location__label">Horário</span>
              <span class="location__value">{company.openingHours}</span>
            </div>
          </div>
        )}

        <a href={mapsLink} class="btn btn--primary location__cta" target="_blank" rel="noopener">
          Traçar rota no Google Maps
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- O mapa só é carregado quando entra na tela, para não pesar no primeiro carregamento. -->
    <div class="location__map" data-map data-map-src={mapsEmbed}>
      <span class="location__map-hint">Carregando o mapa…</span>
    </div>
  </div>
</section>

<style>
  /* A seção é a régua do mapa: com ela como container, `100cqw` é a largura
     da seção — a da tela sem a barra de rolagem. Com `100vw`, que conta a
     barra, o mapa passaria 17px por baixo dela no Windows e abriria rolagem
     lateral. */
  .location {
    padding-block: var(--section-pad);
    background: var(--surface);
    container-type: inline-size;
  }

  .location__inner {
    display: grid;
    gap: 32px;
    align-items: center;
  }

  .location__content {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .location__head {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .location__card {
    /* O recuo interno mora numa variável porque a foto da fachada o desfaz
       com margem negativa para encostar nas bordas do card. */
    --card-pad: 20px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: var(--card-pad);
    overflow: hidden;
    background: var(--surface-2);
    border-radius: var(--radius-lg);
  }

  /* A fachada abre o card de ponta a ponta, como a foto de capa de um perfil
     de lugar: é o que o visitante procura com os olhos quando chega na rua. */
  .location__photo {
    width: calc(100% + var(--card-pad) * 2);
    max-width: none;
    height: auto;
    margin: calc(var(--card-pad) * -1) calc(var(--card-pad) * -1) 0;
  }

  .location__row {
    display: flex;
    gap: 12px;
  }

  /* Sem isto o endereço longo empurra a linha para fora do card. */
  .location__row > div {
    min-width: 0;
  }

  .location__row > svg {
    width: 21px;
    height: 21px;
    color: var(--accent);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .location__row > div {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .location__label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .location__value {
    font-size: 17px;
    font-style: normal;
    line-height: 1.55;
    color: var(--ink);
  }

  /* O CEP desce inteiro para a linha de baixo: no celular ele quebrava no
     hífen, com "53409-" numa linha e "420" na outra. */
  .location__zip {
    white-space: nowrap;
  }

  .location__phone {
    color: var(--ink);
    font-weight: 600;
  }

  .location__phone:hover {
    color: var(--link-hover);
  }

  .location__cta {
    align-self: stretch;
    min-height: 50px;
    padding-inline: 22px;
    font-size: 14px;
  }

  .location__cta svg {
    width: 16px;
    height: 16px;
  }

  /* O mapa ocupa a tela até a borda, como a foto das "Nossas Unidades" no
     site da Masterboi. No celular e no tablet ele sangra as duas bordas, sem
     canto: a calha que sobraria de cada lado só apertava o mapa. */
  .location__map {
    position: relative;
    height: 320px;
    margin-inline: calc(var(--gutter) * -1);
    background: var(--surface-3);
    overflow: hidden;
  }

  .location__map :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  /* O mapa do Google é sempre claro e vira um facho de branco no meio da
     página escura. O escurecimento é leve de propósito: mais que isso e as
     ruas e os nomes começam a sumir. */
  :global(html[data-theme='dark']) .location__map :global(iframe) {
    filter: brightness(0.84) contrast(1.06);
  }

  .location__map-hint {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    color: var(--faint);
  }

  @media (min-width: 480px) {
    .location__card {
      --card-pad: 26px;
    }

    .location__row {
      gap: 14px;
    }

    .location__cta {
      align-self: flex-start;
      padding-inline: 28px;
    }
  }

  @media (min-width: 768px) {
    .location__card {
      --card-pad: 32px;
    }

    .location__map {
      height: 420px;
    }
  }

  @media (min-width: 1080px) {
    /* Com a fachada no card, abertura + card passaram de 800px de altura, e
       o mapa ao lado ou boiava no meio da coluna ou, esticado, virava um
       paredão. A abertura sobe para uma faixa própria, como nas outras
       seções, e embaixo ficam só o card e o mapa, lado a lado e da mesma
       altura. O `contents` é o que deixa o grid enxergar a abertura e o card
       como itens separados sem mudar o HTML, que no celular empilha certo. */
    .location__inner {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      column-gap: 64px;
      row-gap: var(--intro-gap);
      align-items: stretch;
    }

    .location__content {
      display: contents;
    }

    .location__head {
      grid-column: 1 / -1;
      max-width: 720px;
    }

    /* Na coluna estreita a foto inteira ocupava metade do card. O corte
       baixo mantém o letreiro e as portas e tira o céu e o chão. */
    .location__photo {
      aspect-ratio: 2 / 1;
      object-fit: cover;
      object-position: center 40%;
    }

    /* No desktop ele sai da prumada só pela direita, até a borda da tela: a
       margem negativa é a sobra da página (o que passa da largura máxima,
       dividido por dois) mais a calha. Os cantos da esquerda continuam
       arredondados, e os da direita somem na borda. */
    .location__map {
      height: auto;
      min-height: 520px;
      margin-left: 0;
      margin-right: calc((100cqw - min(100cqw, var(--page-max))) / -2 - var(--gutter));
      border-radius: var(--radius-lg) 0 0 var(--radius-lg);
    }
  }
</style>

<script>
  const container = document.querySelector<HTMLElement>('[data-map]');
  const src = container?.dataset.mapSrc;

  if (container && src) {
    const load = () => {
      const iframe = document.createElement('iframe');
      iframe.src = src;
      iframe.loading = 'lazy';
      iframe.title = 'Mapa com a localização da Mirante Camisas e Fardamentos';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      iframe.allowFullscreen = true;
      container.replaceChildren(iframe);
    };

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            observer.disconnect();
            load();
          }
        },
        { rootMargin: '300px' },
      );
      observer.observe(container);
    } else {
      load();
    }
  }
</script>
