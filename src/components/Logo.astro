---
/**
 * Lockup oficial da marca, em vetor.
 *
 * São dois arquivos porque o azul do logo sumiria num fundo escuro: a versão
 * `-dark` é a mesma arte com o azul trocado por branco. O CSS mostra um ou
 * outro conforme o tema — trocar `src` no clique exigiria JavaScript e
 * deixaria a marca piscar.
 *
 * A versão escura leva `loading="lazy"`: imagem com `display: none` não é
 * baixada quando é lazy, então quem fica no claro, que é quase todo mundo,
 * não paga os 19 KB dela. Ela só desce quando o tema escuro a mostra.
 *
 * O tamanho vem de `--logo-height`, que qualquer ancestral pode redefinir: o
 * cabeçalho e o rodapé ficam com o padrão e o hero aumenta a marca inteira.
 * A largura é sempre `auto`, então a proporção nunca se perde.
 */
import { brand } from '../data/site';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={['logo', className]}>
  <img
    class="logo__art logo__art--light"
    src="/logo-mirante.svg"
    alt={brand.name}
    width="2151"
    height="786"
    decoding="async"
    fetchpriority="high"
  />
  <img
    class="logo__art logo__art--dark"
    src="/logo-mirante-dark.svg"
    alt={brand.name}
    width="2151"
    height="786"
    decoding="async"
    loading="lazy"
  />
</span>

<style>
  .logo {
    display: inline-flex;
  }

  .logo__art {
    width: auto;
    height: var(--logo-height, 32px);
  }

  .logo__art--dark {
    display: none;
  }

  :global(html[data-theme='dark']) .logo__art--light {
    display: none;
  }

  :global(html[data-theme='dark']) .logo__art--dark {
    display: block;
  }
</style>
