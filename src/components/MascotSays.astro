---
import { assets, brand } from '../data/site';
---

<section class="mascot-says">
  <div class="container">
    <div class="says" data-anim="scale">
      <div class="says__mascot" aria-hidden="true">
        {
          assets.mascot ? (
            <img class="says__art" src={assets.mascot} alt="" loading="lazy" decoding="async" />
          ) : (
            <span class="says__slot">[Mascote águia]</span>
          )
        }
      </div>

      <div class="says__bubble">
        <p class="says__text">
          Sabe o que o cliente vê antes de falar com a sua equipe? <strong>A farda.</strong>
          Empresa com visual padronizado passa mais confiança.
        </p>
        <p class="says__sign">{brand.slogan}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .mascot-says {
    padding-block: var(--section-pad);
    background: var(--surface);
  }

  .says {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }

  .says__mascot {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 124px;
    flex-shrink: 0;
  }

  .says__art {
    width: 100%;
    height: auto;
  }

  /* Moldura provisória, igual à do card de contato, até o vetor chegar. */
  .says__slot {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 100%;
    height: 158px;
    padding: 10px;
    background: var(--accent-wash);
    border: 1px dashed var(--orange-500);
    border-radius: var(--radius-md);
    color: var(--accent);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: center;
  }

  .says__bubble {
    position: relative;
    padding: 24px 20px;
    background: var(--accent-wash);
    border-radius: var(--radius-lg);
  }

  /* O bico é um quadrado girado, do mesmo tom do balão. No empilhado ele
     aponta para cima, para o mascote que ficou acima. */
  .says__bubble::before {
    content: '';
    position: absolute;
    top: -8px;
    left: 50%;
    width: 20px;
    height: 20px;
    margin-left: -10px;
    background: var(--accent-wash);
    border-radius: 3px;
    transform: rotate(45deg);
  }

  .says__text {
    font-size: clamp(18px, 1rem + 1vw, 26px);
    font-weight: 500;
    line-height: 1.4;
    color: var(--heading);
  }

  .says__text strong {
    font-weight: 700;
  }

  .says__sign {
    margin-top: 14px;
    font-family: var(--font-display);
    font-size: clamp(16px, 0.9rem + 0.6vw, 22px);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--accent);
  }

  @media (min-width: 560px) {
    .says {
      flex-direction: row;
      align-items: center;
      gap: 26px;
    }

    .says__mascot {
      width: 150px;
    }

    .says__slot {
      height: 190px;
    }

    .says__bubble {
      flex: 1;
      padding: 28px 28px;
    }

    /* Lado a lado, o bico gira para apontar para o mascote. */
    .says__bubble::before {
      top: 50%;
      left: -8px;
      margin-top: -10px;
      margin-left: 0;
    }
  }

  @media (min-width: 1080px) {
    .says {
      gap: 40px;
    }

    .says__mascot {
      width: 210px;
    }

    .says__slot {
      height: 260px;
    }

    .says__bubble {
      padding: 44px 48px;
    }

    .says__bubble::before {
      left: -11px;
      width: 26px;
      height: 26px;
      margin-top: -13px;
    }
  }
</style>
