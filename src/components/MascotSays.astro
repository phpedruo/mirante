---
import { assets, brand } from '../data/site';
---

<section class="mascot-says">
  <div class="container">
    {/* A águia apresenta com a asa estendida para a esquerda e não pode ser
        espelhada (o "MIRANTE" da camisa sairia invertido), então ela fica à
        direita, apresentando a fala. No celular ela vem antes, em cima. */}
    <div class="says" data-anim="up">
      <div class="says__stage" aria-hidden="true">
        {
          assets.mascot ? (
            <img
              class="says__art"
              src={assets.mascot}
              alt=""
              loading="lazy"
              decoding="async"
              width="546"
              height="623"
            />
          ) : (
            <span class="says__slot">[Mascote águia]</span>
          )
        }
      </div>

      <div class="says__bubble">
        <p class="says__text">
          Sabe o que o cliente vê antes de falar com a sua equipe? <strong>A farda.</strong><br>
          Empresa com visual padronizado passa mais confiança.
        </p>
        <p class="says__sign">{brand.slogan}</p>
      </div>
    </div>
  </div>
</section>

<style>
  /* A seção é a régua do palco: com ela como container, `100cqw` é a largura
     da tela sem a barra de rolagem, e é com ela que o semicírculo da águia
     chega exatamente na borda direita. O clipe lateral é só garantia. */
  .mascot-says {
    padding-block: var(--section-pad);
    /* Cinza, e não branco, por causa dos vizinhos: a fala fica entre os
       clientes e o FAQ, que são faixas cinza, e uma tira branca de uma seção
       só entre as duas lia como engano de montagem. Assim o meio da página
       vira uma região cinza contínua — clientes, fala e FAQ — em vez de três
       trocas de cor em sequência. */
    background: var(--surface-2);
    container-type: inline-size;
    overflow-x: clip;
  }

  .says {
    display: grid;
    gap: 28px;
    align-items: center;
  }

  /* ---- O palco da águia ---------------------------------------------- *
     Um semicírculo branco que sai da borda direita da tela, como o círculo
     atrás do robô no "Canal de Ética" do site da Masterboi. Ele é mais baixo
     que a águia e fica no pé dela, então a cabeça escapa por cima — é o que
     tira a águia de dentro de uma moldura e a põe na frente da página. */
  .says__stage {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .says__stage::before {
    content: '';
    position: absolute;
    left: 8%;
    right: calc((100cqw - min(100cqw, var(--page-max))) / -2 - var(--gutter));
    bottom: 0;
    height: 74%;
    background: var(--card);
    border-radius: 999px 0 0 999px;
  }

  /* O arquivo tem 546px de largura (é o original inteiro), então até 400px a
     águia ainda tem folga em tela comum. */
  .says__art {
    position: relative;
    width: min(240px, 68%);
    height: auto;
  }

  /* Moldura provisória, igual à do card de contato, até a arte chegar. */
  .says__slot {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 180px;
    height: 220px;
    padding: 10px;
    background: var(--accent-wash);
    border: 1px dashed var(--orange-500);
    border-radius: var(--radius-md);
    color: var(--accent);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: center;
  }

  /* ---- A fala -------------------------------------------------------- */
  .says__bubble {
    position: relative;
    padding: 26px 22px;
    background: var(--accent-wash);
    border-radius: var(--radius-lg);
  }

  /* O bico é um quadrado girado, do mesmo tom do balão. No empilhado ele
     aponta para cima, para a águia que ficou acima. */
  .says__bubble::before {
    content: '';
    position: absolute;
    top: -8px;
    left: 50%;
    width: 20px;
    height: 20px;
    margin-left: -10px;
    background: var(--accent-wash);
    border-radius: 3px;
    transform: rotate(45deg);
  }

  .says__text {
    font-size: clamp(20px, 1rem + 1.4vw, 32px);
    font-weight: 500;
    line-height: 1.35;
    color: var(--heading);
  }

  .says__text strong {
    font-weight: 700;
  }

  .says__sign {
    margin-top: 16px;
    font-family: var(--font-display);
    font-size: clamp(18px, 0.9rem + 1vw, 28px);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--accent);
  }

  /* Lado a lado: a fala na esquerda e a águia na direita, apresentando. O
     HTML continua com a águia antes, que é a ordem certa no celular. */
  @media (min-width: 768px) {
    .says {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      grid-template-areas: 'fala palco';
      gap: 40px;
    }

    .says__stage {
      grid-area: palco;
    }

    .says__bubble {
      grid-area: fala;
      padding: 36px 36px;
    }

    .says__art {
      width: min(330px, 86%);
    }

    /* O bico gira para a direita, onde a águia está. */
    .says__bubble::before {
      top: 50%;
      left: auto;
      right: -8px;
      margin-top: -10px;
      margin-left: 0;
    }
  }

  @media (min-width: 1080px) {
    .says {
      gap: 64px;
    }

    .says__art {
      width: 400px;
    }

    .says__bubble {
      padding: 52px 56px;
    }

    .says__bubble::before {
      right: -11px;
      width: 26px;
      height: 26px;
      margin-top: -13px;
    }
  }
</style>
