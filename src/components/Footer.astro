---
import Logo from './Logo.astro';
import { address, brand, company, contact, privacy } from '../data/site';

const year = new Date().getFullYear();

// Razão social quando ela for preenchida; até lá, o nome da marca.
const legalName = company.legalName || brand.name;

const links = [
  { href: '#produtos', label: 'Produtos' },
  { href: '#clientes', label: 'Quem veste Mirante' },
  { href: '#duvidas', label: 'Dúvidas' },
  { href: '#localizacao', label: 'Onde estamos' },
];
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__cols">
      <div class="footer__brand">
        <Logo />
        <p class="footer__about">
          Fardamento escolar e industrial, polos, camisas promocionais, batas, aventais, brindes e
          bandeiras. Fábrica em {address.city} – {address.state}.
        </p>
      </div>

      <div class="footer__col">
        <h2 class="footer__title">Navegue</h2>
        <ul>
          {links.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer__col">
        <h2 class="footer__title">Contato</h2>
        <ul>
          <li>
            <a href={contact.whatsappUrl()} target="_blank" rel="noopener">
              {contact.whatsappDisplay}
            </a>
          </li>
          <li>
            <a href={brand.instagramUrl} target="_blank" rel="noopener">{brand.instagram}</a>
          </li>
          {contact.email && (
            <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
          )}
        </ul>
      </div>

      <div class="footer__col">
        <h2 class="footer__title">Endereço</h2>
        <address class="footer__address">
          {address.street}<br />
          {address.district}<br />
          {address.city} – {address.state}, {address.zip}
        </address>
      </div>
    </div>

    <div class="footer__bottom">
      <span class="footer__legal">
        © {year} {legalName}. Todos os direitos reservados.
        {company.cnpj && <span class="footer__cnpj">CNPJ {company.cnpj}</span>}
        <button type="button" class="footer__privacy" commandfor={privacy.dialogId} command="show-modal">
          Política de privacidade
        </button>
      </span>
      <span>{brand.slogan}</span>
    </div>
  </div>
</footer>

<style>
  /* Faixa de outro fundo: o espaço é interno à faixa, então usa --band-pad. */
  .footer {
    padding-block: var(--band-pad) 40px;
    background: var(--surface-2);
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .footer__cols {
    display: grid;
    gap: 32px;
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .footer__about {
    max-width: 320px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--muted-2);
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .footer__col ul {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer__title {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: normal;
    color: var(--heading);
  }

  .footer__col a {
    font-size: 15px;
    color: var(--muted-2);
  }

  .footer__col a:hover {
    color: var(--heading);
  }

  .footer__address {
    font-size: 15px;
    font-style: normal;
    line-height: 1.65;
    color: var(--muted-2);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
    font-size: 14px;
    color: var(--faint);
  }

  .footer__cnpj::before,
  .footer__privacy::before {
    content: ' · ';
  }

  /* O ponto separador é do texto da linha, não do link: sem isto ele herdaria
     o sublinhado e a cor de hover. */
  /* É um botão, porque abre o diálogo em vez de navegar, mas lê como link. */
  .footer__privacy {
    padding: 0;
    background: none;
    border: 0;
    font: inherit;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .footer__privacy::before {
    display: inline-block;
    white-space: pre;
    text-decoration: none;
  }

  .footer__privacy:hover {
    color: var(--heading);
  }

  @media (min-width: 640px) {
    .footer__cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 40px;
    }
  }

  @media (min-width: 1080px) {
    .footer__cols {
      grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr));
      gap: 48px;
    }

    .footer__inner {
      gap: 48px;
    }
  }
</style>
