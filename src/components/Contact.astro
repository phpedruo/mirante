---
import { assets, brand, contact, formAccessKey, privacy, quantities } from '../data/site';

if (!formAccessKey) {
  console.warn(
    '[mirante] formAccessKey está vazio em src/data/site.ts — o formulário vai orientar o visitante a usar o WhatsApp em vez de enviar o e-mail.',
  );
}

const whatsappUrl = contact.whatsappUrl();

const nextSteps = [
  'Você manda o logo e as referências, e um consultor faz o orçamento.',
  'Depois do orçamento, você recebe a prévia da peça para aprovar.',
  'Aprovou, a gente produz e entrega no nosso veículo.',
];
---

<section class="contact" id="contato">
  <div class="container">
    <div class="contact__card" data-anim="scale">
      <div class="contact__pitch">
        <h2 class="contact__title">Opa! Vi que você precisa de fardamento...</h2>
        <p class="contact__slogan">{brand.slogan}</p>

        <div class="contact__mascot-row">
          <div class:list={['contact__mascot', assets.mascot && 'contact__mascot--art']} aria-hidden="true">
            {
              assets.mascot ? (
                <img
                  class="contact__mascot-art"
                  src={assets.mascot}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  width="420"
                  height="479"
                />
              ) : (
                '[Mascote águia]'
              )
            }
          </div>
          <div class="contact__channels">
            <a href={whatsappUrl} class="btn btn--accent" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15.5v3a2 2 0 0 1-2.2 2 19.5 19.5 0 0 1-8.5-3 19 19 0 0 1-6-6 19.5 19.5 0 0 1-3-8.6A2 2 0 0 1 3.3 1h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L7.2 9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2z"></path>
              </svg>
              {contact.whatsappDisplay}
            </a>
            <a class="contact__instagram" href={brand.instagramUrl} target="_blank" rel="noopener">
              {brand.instagram}
            </a>
          </div>
        </div>
      </div>

      <form class="contact__form" data-form data-access-key={formAccessKey} novalidate>
        <div class="contact__grid">
          <label class="field">
            <span class="field__label">Seu nome</span>
            <input class="field__control" type="text" name="nome" autocomplete="name" placeholder="Nome completo" required />
          </label>
          <label class="field">
            <span class="field__label">Empresa ou escola</span>
            <input class="field__control" type="text" name="empresa" autocomplete="organization" placeholder="Nome da instituição" />
          </label>
        </div>

        <div class="contact__grid">
          <label class="field">
            <span class="field__label">WhatsApp</span>
            <input class="field__control" type="tel" name="whatsapp" autocomplete="tel" placeholder="(00) 00000-0000" required />
          </label>
          <label class="field">
            <span class="field__label">Quantidade</span>
            <select class="field__control" name="quantidade">
              {quantities.map((option) => <option value={option}>{option}</option>)}
            </select>
          </label>
        </div>

        <label class="field">
          <span class="field__label">O que você precisa</span>
          <textarea
            class="field__control field__control--area"
            name="mensagem"
            rows="3"
            placeholder="Ex.: 80 camisas polo bordadas com o logo da empresa."
            required></textarea>
        </label>

        <!-- Campo isca: preenchido só por robô, o envio é descartado. -->
        <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" />

        <button type="submit" class="btn btn--primary contact__submit" data-form-submit>
          Faça seu orçamento
        </button>

        <p class="contact__status" data-form-status role="status" aria-live="polite"></p>
        <!-- Aviso da LGPD. Não há caixa de consentimento de propósito: o pedido de
             orçamento é feito a pedido do próprio visitante, e o tratamento se apoia
             em "procedimentos preliminares de contrato" (art. 7º, V), não em
             consentimento. O que a lei pede aqui é transparência: avisar, no ponto
             da coleta, que o envio segue a política, e deixá-la a um clique. -->
        <p class="contact__note">
          Ao enviar, você concorda com a nossa{' '}
          <button type="button" class="contact__privacy" commandfor={privacy.dialogId} command="show-modal">
            política de privacidade</button>.
        </p>

        {
          // Sem a chave do Web3Forms o envio nunca chega ao painel de sucesso.
          // Este atalho existe só em `npm run dev` e não vai para o build.
          import.meta.env.DEV && (
            <button type="button" class="contact__dev" data-form-preview>
              dev: ver painel de sucesso
            </button>
          )
        }
      </form>

      <div class="contact__done" data-form-done role="status" hidden>
        <span class="contact__done-check" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="m4 12.5 5 5 11-11"></path>
          </svg>
        </span>

        <h3 class="contact__done-title" tabindex="-1" data-form-done-title>Recebido. Obrigado!</h3>

        <p class="contact__done-text">
          Nossa equipe especializada já está com o seu pedido e entra em contato pelo WhatsApp
          que você deixou.
        </p>

        <div class="contact__done-steps">
          <span class="contact__done-label">O que acontece agora</span>
          <ol class="contact__steps">
            {nextSteps.map((step) => (
              <li class="contact__step">{step}</li>
            ))}
          </ol>
        </div>

        <a href={whatsappUrl} class="btn btn--accent contact__done-cta" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15.5v3a2 2 0 0 1-2.2 2 19.5 19.5 0 0 1-8.5-3 19 19 0 0 1-6-6 19.5 19.5 0 0 1-3-8.6A2 2 0 0 1 3.3 1h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L7.2 9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2z"></path>
          </svg>
          Adiantar pelo WhatsApp
        </a>

        <button type="button" class="contact__again" data-form-again>Enviar outro pedido</button>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: var(--section-pad);
    background: var(--surface);
  }

  .contact__card {
    display: grid;
    gap: 32px;
    padding: 26px 18px;
    background: var(--brand-fill);
    border-radius: var(--radius-lg);
  }

  .contact__pitch {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .contact__title {
    font-size: clamp(24px, 1.3rem + 2vw, 40px);
    font-weight: 700;
    line-height: 1.12;
    color: #fff;
  }

  .contact__slogan {
    font-family: var(--font-display);
    font-size: clamp(24px, 1.3rem + 2vw, 40px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--orange-500);
  }

  /* Abaixo de 540px o mascote e o botão do telefone não cabem lado a lado:
     o rótulo do botão é largo e não pode encolher além do texto. */
  .contact__mascot-row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  .contact__mascot {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 132px;
    height: 169px;
    padding: 10px;
    background: rgb(255 255 255 / 8%);
    border: 1px dashed rgb(255 255 255 / 35%);
    border-radius: var(--radius-md);
    color: rgb(255 255 255 / 75%);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: center;
    flex-shrink: 0;
  }

  /* Com o vetor no lugar, a moldura provisória some. */
  .contact__mascot--art {
    height: auto;
    padding: 0;
    background: none;
    border: 0;
  }

  .contact__mascot-art {
    width: 100%;
    height: auto;
  }

  .contact__channels {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }

  .contact__channels .btn {
    min-height: 60px;
    padding: 15px 26px;
    font-size: 17px;
  }

  .contact__channels .btn svg {
    width: 22px;
    height: 22px;
  }

  .contact__instagram {
    font-size: 17px;
    color: rgb(255 255 255 / 72%);
  }

  .contact__instagram:hover {
    color: #fff;
  }

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 20px;
    background: var(--card);
    border-radius: var(--radius-md);
  }

  .contact__grid {
    display: grid;
    gap: 14px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .field__label {
    font-size: 13px;
    font-weight: 600;
    color: var(--muted-2);
  }

  .field__control {
    width: 100%;
    padding: 15px 16px;
    background: var(--surface-2);
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-size: 15px;
    color: var(--ink);
    transition: border-color 0.18s ease, background-color 0.18s ease;
  }

  .field__control::placeholder {
    color: var(--faint-2);
  }

  .field__control:focus {
    background: var(--surface);
    border-color: var(--blue-600);
  }

  .field__control--area {
    min-height: 96px;
    resize: vertical;
    line-height: 1.5;
  }

  .contact__submit {
    margin-top: 4px;
  }

  .contact__submit[disabled] {
    opacity: 0.7;
    cursor: progress;
  }

  .contact__status {
    font-size: 15px;
    line-height: 1.5;
    color: var(--muted);
  }

  .contact__status:empty {
    display: none;
  }

  .contact__status[data-state='erro'] {
    color: #b3261e;
  }

  .contact__status[data-state='ok'] {
    color: #1b6b3a;
  }

  /* Vermelho e verde escuros somem no painel escuro; aqui eles clareiam. */
  :global(html[data-theme='dark']) .contact__status[data-state='erro'] {
    color: #ff9b91;
  }

  :global(html[data-theme='dark']) .contact__status[data-state='ok'] {
    color: #6fd39b;
  }

  .contact__note {
    font-size: 13px;
    line-height: 1.5;
    color: var(--faint);
    text-align: center;
  }

  /* É um botão, porque abre o diálogo em vez de navegar, mas lê como link. */
  .contact__privacy {
    padding: 0;
    background: none;
    border: 0;
    font: inherit;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    /* Quebra inteiro para a linha de baixo, nunca no meio do nome. */
    white-space: nowrap;
    cursor: pointer;
  }

  .contact__privacy:hover {
    color: var(--link-hover);
  }

  .contact__dev {
    align-self: center;
    padding: 6px 10px;
    background: none;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-size: 12px;
    color: var(--faint);
    cursor: pointer;
  }

  /* ---- Painel de agradecimento ------------------------------------ *
     Ocupa o mesmo lugar do formulário dentro do card azul, com o mesmo
     fundo e o mesmo raio, para a seção não mudar de cara no envio. */
  .contact__done {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding: 24px 20px;
    background: var(--card);
    border-radius: var(--radius-md);
    animation: done-in 0.45s ease-out both;
  }

  /* `display: flex` acima venceria o [hidden] do navegador. */
  .contact__done[hidden],
  .contact__form[hidden] {
    display: none;
  }

  @keyframes done-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  .contact__done-check {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: var(--accent-wash);
    border-radius: var(--pill);
    color: var(--accent);
  }

  .contact__done-check svg {
    width: 24px;
    height: 24px;
  }

  .contact__done-title {
    font-size: clamp(22px, 1.2rem + 1.4vw, 30px);
    font-weight: 700;
  }

  .contact__done-title:focus-visible {
    outline-offset: 4px;
  }

  .contact__done-text {
    font-size: 16px;
    line-height: 1.55;
    color: var(--muted);
  }

  .contact__done-steps {
    width: 100%;
    padding: 18px 20px;
    background: var(--surface-2);
    border-radius: var(--radius-sm);
  }

  .contact__done-label {
    display: block;
    margin-bottom: 12px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .contact__steps {
    display: flex;
    flex-direction: column;
    gap: 12px;
    counter-reset: step;
  }

  .contact__step {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink);
    counter-increment: step;
  }

  .contact__step::before {
    content: counter(step);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background: var(--brand-fill);
    border-radius: var(--pill);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .contact__done-cta {
    align-self: stretch;
  }

  .contact__done-cta svg {
    width: 20px;
    height: 20px;
  }

  .contact__again {
    align-self: center;
    padding: 0;
    background: none;
    border: 0;
    font-family: inherit;
    font-size: 14px;
    color: var(--muted-2);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .contact__again:hover {
    color: var(--link-hover);
  }

  @media (min-width: 480px) {
    .contact__card {
      padding: 36px 24px;
    }

    .contact__form {
      padding: 24px;
    }

    .contact__done {
      padding: 28px 24px;
    }
  }

  @media (min-width: 540px) {
    /* `wrap` é a válvula da faixa entre 1080px e ~1260px, onde o card já se
       divide em duas colunas e os dois juntos não cabem na coluna: o botão
       desce inteiro em vez de espremer o rótulo. */
    .contact__mascot-row {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: flex-end;
      gap: 20px;
    }

    .contact__mascot {
      width: 150px;
      height: 192px;
    }

    .contact__channels {
      padding-bottom: 8px;
    }
  }

  @media (min-width: 560px) {
    .contact__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 768px) {
    .contact__card {
      padding: 48px 40px;
    }

    .contact__form {
      padding: 32px;
    }

    .contact__done {
      gap: 18px;
      padding: 36px 32px;
    }

    .contact__mascot {
      width: 196px;
      height: 251px;
    }

    .contact__channels .btn {
      min-height: 64px;
      font-size: 18px;
    }

    .contact__channels .btn svg {
      width: 24px;
      height: 24px;
    }

    .contact__instagram {
      font-size: 18px;
    }
  }

  @media (min-width: 1080px) {
    .contact__card {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 72px;
      padding: 72px;
      border-radius: var(--radius-xl);
    }

    .contact__pitch {
      gap: 26px;
    }

    .contact__form {
      padding: 36px;
      border-radius: var(--radius-lg);
    }

    .contact__done {
      padding: 44px 40px;
      border-radius: var(--radius-lg);
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-form]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');
  const submit = document.querySelector<HTMLButtonElement>('[data-form-submit]');
  const done = document.querySelector<HTMLElement>('[data-form-done]');
  const doneTitle = document.querySelector<HTMLElement>('[data-form-done-title]');
  const again = document.querySelector<HTMLButtonElement>('[data-form-again]');

  const say = (message: string, state: 'ok' | 'erro') => {
    if (!status) return;
    status.textContent = message;
    status.dataset.state = state;
  };

  /** Troca o formulário pelo agradecimento, dentro do mesmo card. */
  const showDone = (firstName: string) => {
    if (!form || !done) return;

    if (doneTitle) {
      doneTitle.textContent = firstName ? `Recebido, ${firstName}. Obrigado!` : 'Recebido. Obrigado!';
    }

    say('', 'ok');
    form.hidden = true;
    done.hidden = false;
    // Quem navega por teclado ou leitor de tela precisa ser levado até a resposta.
    doneTitle?.focus();
  };

  again?.addEventListener('click', () => {
    if (!form || !done) return;
    done.hidden = true;
    form.hidden = false;
    form.querySelector<HTMLInputElement>('input, textarea, select')?.focus();
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!form.reportValidity()) return;

    const accessKey = form.dataset.accessKey;
    if (!accessKey) {
      say(
        'O envio pelo site ainda não está ativo. Fale com a gente pelo WhatsApp que respondemos na hora.',
        'erro',
      );
      return;
    }

    const data = Object.fromEntries(new FormData(form).entries());
    if (data.botcheck) return;

    // Lido antes do reset, para o agradecimento poder chamar a pessoa pelo nome.
    const firstName = String(data.nome ?? '').trim().split(/\s+/)[0] ?? '';

    submit?.setAttribute('disabled', 'true');
    say('Enviando...', 'ok');

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          ...data,
          access_key: accessKey,
          subject: 'Novo pedido de orçamento pelo site',
          from_name: 'Site Mirante',
        }),
      });

      if (!response.ok) throw new Error(`HTTP ${response.status}`);

      form.reset();
      showDone(firstName);
    } catch {
      say(
        'Não conseguimos enviar agora. Tente de novo ou chame a gente pelo WhatsApp.',
        'erro',
      );
    } finally {
      submit?.removeAttribute('disabled');
    }
  });

  // O botão só é renderizado em desenvolvimento; em produção não existe.
  document.querySelector<HTMLButtonElement>('[data-form-preview]')?.addEventListener('click', () => {
    const nome = form?.querySelector<HTMLInputElement>('[name="nome"]')?.value ?? '';
    showDone(nome.trim().split(/\s+/)[0] ?? '');
  });
</script>
