---
import Logo from './Logo.astro';
import { brand, contact, heroSlides, heroStats } from '../data/site';

const whatsappUrl = contact.whatsappUrl(
  'Olá! Vim pelo site e gostaria de um orçamento de fardamento.',
);

// Dois ciclos de 0 a 9: o rolo dá uma volta inteira antes de parar no dígito,
// que é o que dá a sensação de caça-níquel. O repouso é o segundo ciclo.
const REEL = Array.from({ length: 20 }, (_, index) => index % 10);
---

<section class="hero frestas" id="topo">
  <div class="container hero__inner">
    <div class="hero__content">
      <div class="hero__brand" data-anim="hero">
        <Logo />
      </div>

      <div class="hero__headline">
        <h1 class="title-lg" data-anim="hero">
          <span class="eyebrow hero__kicker">Fábrica de fardamentos em Paulista – PE</span>{' '}
          Padrão e qualidade<br />para o seu fardamento
        </h1>
        <p class="hero__slogan" data-anim="hero">{brand.slogan}</p>
      </div>

      <p class="lead hero__text" data-anim="hero">
        Fardamento escolar e operacional, polo, camisa promocional, bata, avental, camisa UV,
        brinde <strong class="hero__more">e muito mais</strong> — com acabamento conferido peça
        por peça.
      </p>

      <div class="hero__actions" data-anim="hero">
        <a href="#contato" class="btn btn--primary">
          Faça seu orçamento
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path>
          </svg>
        </a>
        <a href={whatsappUrl} class="btn btn--ghost" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15.5v3a2 2 0 0 1-2.2 2 19.5 19.5 0 0 1-8.5-3 19 19 0 0 1-6-6 19.5 19.5 0 0 1-3-8.6A2 2 0 0 1 3.3 1h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L7.2 9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2z"></path>
          </svg>
          Fale agora com um consultor
        </a>
      </div>
    </div>

    <div class="hero__media" data-anim="hero-media">
      {
        heroSlides.length > 0 ? (
          <div class="outdoor" data-outdoor>
            {heroSlides.map((slide, index) => (
              <div class="outdoor__slide" data-outdoor-slide data-kind={slide.kind ?? 'foto'}>
                <img
                  class="outdoor__img"
                  src={slide.src}
                  alt={slide.alt}
                  decoding="async"
                  fetchpriority={index === 0 ? 'high' : undefined}
                />
                {slide.promo && (
                  <div class="promo" data-outdoor-promo>
                    {slide.promo.badge && <span class="promo__badge">{slide.promo.badge}</span>}
                    <p class="promo__title">{slide.promo.title}</p>
                    {slide.promo.text && <p class="promo__text">{slide.promo.text}</p>}
                  </div>
                )}
              </div>
            ))}

            {/* Enche enquanto a arte da vez espera a sua hora. Só aparece com
                JavaScript: sem ele não há troca, e uma régua parada mentiria. */}
            <div class="outdoor__timer" aria-hidden="true">
              <span class="outdoor__timer-fill" data-outdoor-timer></span>
            </div>
          </div>
        ) : (
          <div class="photo-slot hero__photo">[Outdoor — artes e fotos]</div>
        )
      }
    </div>

    <ul class="hero__stats" data-anim="hero">
      {heroStats.map((stat) => (
        <li class="stat">
          {stat.number && (
            <span class="stat__value">
              {/* O número de verdade, para leitor de tela e para o texto copiado. */}
              <span class="visually-hidden">{stat.number}{stat.suffix}</span>

              <span class="stat__odometer" aria-hidden="true">
                {stat.number.split('').map((digit) => (
                  <span class="reel">
                    <span class="reel__strip" style={`--digit:${digit}`} data-reel={digit}>
                      {REEL.map((value) => (
                        <span class="reel__digit">{value}</span>
                      ))}
                    </span>
                  </span>
                ))}
              </span>

              {stat.suffix && <span aria-hidden="true">{stat.suffix}</span>}
            </span>
          )}
          <span class="stat__text">{stat.text}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* No celular a logo abre a página sozinha, centrada, e o espaço acima dela
     é igual ao espaço abaixo: com 80px em cima e 42px embaixo, a marca lia
     como caída para o texto, e não como a abertura da página. Os dois lados
     usam o --section-pad. Embaixo, ele é a margem da marca somada ao gap dos
     blocos do hero, por isso o gap vira variável. */
  .hero {
    padding-block: var(--section-pad);
    background: var(--surface);
    /* No celular o outdoor sangra a calha por margem negativa; o clipe é o
       que impede essa sobra de virar rolagem horizontal. */
    overflow-x: clip;
  }

  .hero__inner {
    display: grid;
    gap: 40px;
    align-items: center;
  }

  .hero__content {
    --hero-gap: 26px;

    display: flex;
    flex-direction: column;
    gap: var(--hero-gap);
  }

  /* A marca abre a página em tamanho grande. Só a altura é definida; a
     largura sai da proporção do vetor, então o lockup nunca distorce.
     O piso de 100px é o que vale no celular: com 80px a logo ocupava só
     60% da tela e ficava tímida perto do título; com 100px ela abre a
     página com presença e os dois botões continuam na primeira tela. */
  .hero__brand {
    --logo-height: clamp(100px, 15vw, 140px);

    display: flex;
    align-items: center;
    /* No celular a marca abre a página sozinha: centralizada e com o mesmo
       espaço acima e abaixo dela. Encostada à esquerda e no mesmo gap dos
       outros blocos, o lockup deitado lia como mais uma linha de texto, e
       não como a abertura da página. A partir de 768px ela volta para a
       prumada do título, que é onde a coluna já é larga o bastante para a
       marca centralizada ficar boiando. */
    justify-content: center;
    margin-bottom: calc(var(--section-pad) - var(--hero-gap));
  }

  /* "e muito mais" fecha a lista de produtos: a enumeração é longa e mesmo
     assim não cabe tudo que a fábrica faz, então ela precisa dizer que não
     acaba ali. Ganha peso e o laranja de texto para ser lida como parte da
     lista, e não como reticência esquecida no fim da frase. */
  .hero__more {
    color: var(--accent);
    font-weight: 600;
  }

  .hero__headline {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* A linha de cima do título diz o que a Mirante é e onde fica. Ela mora
     dentro do <h1>, e não num parágrafo acima, porque é o título da página
     que o Google lê para entender o assunto — e ali faltava a cidade. */
  .hero__kicker {
    margin-bottom: 14px;
    letter-spacing: 0.12em;
  }

  .hero__slogan {
    font-family: var(--font-display);
    font-size: clamp(22px, 1.1rem + 2vw, 30px);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--accent);
  }

  .hero__text {
    max-width: 520px;
  }

  /* Abaixo de 600px os dois não cabem lado a lado, e o segundo — mais largo —
     caía sozinho na linha de baixo, esticado na calha inteira: um degrau maior
     que o primeiro, como se a ação principal fosse ele. Empilhados e do mesmo
     tamanho, os dois voltam a ler como um par. */
  .hero__actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
  }

  .hero__actions .btn svg {
    width: 18px;
    height: 18px;
  }

  .hero__photo {
    height: 300px;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-hero);
  }

  /* ---- Outdoor ----------------------------------------------------- *
     As imagens ficam empilhadas no mesmo quadro; a coreografia em
     animations.ts puxa a atual para fora enquanto a próxima entra.

     No celular o quadro sangra até as duas bordas da tela, sem canto; no
     desktop ele fica na prumada do conteúdo, com os quatro cantos
     arredondados. Nos dois casos não há sombra: sombra é o que diz "isto
     está flutuando acima do fundo", e é o que fazia a imagem ler como cartão
     colado sobre a página. */
  .outdoor {
    position: relative;
    height: 300px;
    margin-inline: calc(var(--gutter) * -1);
    overflow: hidden;
    background: var(--surface-2);
  }

  .outdoor__slide {
    position: absolute;
    inset: 0;
  }

  /* Sem JavaScript, ou com "reduzir movimento", o quadro para na primeira
     imagem em vez de mostrar todas empilhadas. */
  .outdoor__slide + .outdoor__slide {
    opacity: 0;
  }

  .outdoor__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Arte de divulgação aparece inteira: o texto dela encosta na borda, e
     preencher o quadro comeria palavra. As sobras laterais ganham o azul da
     marca, o que faz a arte parecer montada ali de propósito em vez de
     sobrando num quadro grande demais. */
  .outdoor__slide[data-kind='arte'] {
    background: linear-gradient(160deg, var(--blue-700), var(--blue-900));
  }

  .outdoor__slide[data-kind='arte'] .outdoor__img {
    object-fit: contain;
  }

  /* ---- Recado promocional sobre a imagem ---- */
  /* O véu escuro existe para o texto: sobre foto clara, branco em cima de
     branco some. Ele é mais dedicado embaixo, onde o texto fica, e se
     dissolve antes da metade para não escurecer a peça. */
  .promo {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 28px var(--gutter) 26px;
    background: linear-gradient(to top, rgb(4 14 43 / 82%), rgb(4 14 43 / 0%));
    color: #fff;
  }

  .promo__badge {
    padding: 5px 12px;
    background: var(--orange-500);
    border-radius: var(--pill);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .promo__title {
    font-size: clamp(20px, 1rem + 1.4vw, 28px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .promo__text {
    font-size: 15px;
    line-height: 1.5;
    opacity: 0.88;
  }

  /* ---- Régua do tempo ---- */
  /* Nasce escondida e só aparece quando a passagem começa de fato: sem
     JavaScript, com "reduzir movimento" ou com uma imagem só, não há tempo
     a contar, e uma régua parada no zero prometeria um movimento que não
     vem. Quem a revela é o animations.ts. */
  .outdoor__timer {
    position: absolute;
    inset: auto 0 0 0;
    height: 3px;
    background: rgb(255 255 255 / 28%);
    visibility: hidden;
  }

  .outdoor__timer-fill {
    display: block;
    height: 100%;
    background: var(--orange-500);
    /* Nasce vazia e cresce por transform, nunca por largura: largura refaz o
       layout a cada quadro. O GSAP só aparece com JS, então sem ele a régua
       fica zerada e invisível. */
    transform: scaleX(0);
    transform-origin: left center;
  }

  /* ---- Rodapé do hero ---------------------------------------------- */
  /* Linha de base comum: um item sem número, se voltar a existir, fica na
     mesma linha dos numerados em vez de flutuar acima deles. */
  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 16px 32px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .stat {
    display: flex;
    align-items: baseline;
    gap: 9px;
  }

  .stat__value {
    /* Altura de uma casa do rolo. Vale para a janela, para cada dígito e para
       o passo do giro — os três precisam bater, senão o número desalinha. */
    --reel-h: 1.15em;

    display: inline-flex;
    align-items: center;
    font-size: clamp(26px, 1.1rem + 1.5vw, 36px);
    font-weight: 700;
    letter-spacing: -0.02em;
    /* Sem largura tabular cada dígito ocupa um espaço diferente e o número
       treme na horizontal enquanto gira. */
    font-variant-numeric: tabular-nums;
    color: var(--heading);
  }

  .stat__odometer {
    display: inline-flex;
    /* Copiar a faixa deve levar "10+", não os vinte dígitos do rolo. */
    user-select: none;
  }

  .reel {
    display: block;
    width: 1ch;
    height: var(--reel-h);
    overflow: hidden;
  }

  /* Posição de repouso, a mesma que o GSAP escreve no fim: sem JS o número já
     nasce certo, em vez de mostrar o zero do começo do rolo. */
  .reel__strip {
    display: block;
    transform: translateY(calc((var(--digit) + 10) * var(--reel-h) * -1));
    /* A cor é declarada aqui, e não herdada: herdando, o Chromium não repinta
       a faixa quando o botão troca o tema com a página aberta, e os dígitos
       ficavam azul-marinho sobre o fundo escuro. */
    color: var(--heading);
  }

  .reel__digit {
    display: block;
    height: var(--reel-h);
    line-height: var(--reel-h);
    text-align: center;
  }

  .stat__text {
    font-size: 15px;
    line-height: 1.4;
    color: var(--muted);
  }

  @media (min-width: 600px) {
    .hero__actions {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
    }
  }

  @media (min-width: 768px) {
    /* Com a marca ao lado do título, o hero abre logo abaixo do cabeçalho
       sticky: um degrau a mais de folga no topo, e o --section-pad normal
       embaixo, que forma o encontro com a seção seguinte. */
    .hero {
      padding-top: calc(var(--section-pad) + var(--intro-gap));
    }

    .hero__brand {
      justify-content: flex-start;
      margin-bottom: 0;
    }

    .hero__photo,
    .outdoor {
      height: 420px;
    }

    .hero__stats {
      gap: 18px 48px;
    }
  }

  @media (min-width: 1080px) {
    .hero__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 72px;
    }

    .hero__content {
      gap: 30px;
    }

    .hero__photo,
    .outdoor {
      height: 520px;
    }

    /* No desktop o quadro termina na borda do conteúdo, na mesma prumada de
       todas as outras seções: sangrando até a borda da tela ele ficava fora
       do alinhamento da página, jogado para a direita. Como ele não encosta
       mais na borda da tela, os quatro cantos são arredondados: com o lado
       direito reto e solto no meio da página, o quadro lia como torto. */
    .outdoor {
      margin-inline: 0;
      border-radius: var(--radius-lg);
    }

    /* A faixa é o rodapé do hero inteiro, não da coluna de texto: a régua
       atravessa as duas colunas, então os itens se espalham por baixo dela em
       vez de ficarem amontoados num canto. */
    .hero__stats {
      grid-column: 1 / -1;
      justify-content: space-between;
      gap: 20px 48px;
      padding-top: 30px;
    }
  }
</style>
