---
import Logo from './Logo.astro';
import { brand, contact, heroSlides, heroStats } from '../data/site';

const whatsappUrl = contact.whatsappUrl(
  'Olá! Vim pelo site e gostaria de um orçamento de fardamento.',
);

// Dois ciclos de 0 a 9: o rolo dá uma volta inteira antes de parar no dígito,
// que é o que dá a sensação de caça-níquel. O repouso é o segundo ciclo.
const REEL = Array.from({ length: 20 }, (_, index) => index % 10);

// A legenda só existe se tiver o que mostrar: o recado de alguma imagem, ou a
// régua do tempo, que só conta quando há passagem (duas imagens ou mais).
const hasLegend = heroSlides.length > 1 || heroSlides.some((slide) => slide.promo);
---

<section class="hero frestas" id="topo">
  {
    /* O fundo da seção: as imagens passam de ponta a ponta, esmaecidas, atrás
       das frestas e do texto, como o vídeo no hero do site da Masterboi. Ele
       é decoração — o recado de cada imagem mora na legenda, onde dá para
       ler —, e por isso sai inteiro da árvore de acessibilidade. */
    heroSlides.length > 0 && (
      <div class="hero__backdrop" data-anim="hero-backdrop" aria-hidden="true">
        <div class="outdoor" data-outdoor>
          {heroSlides.map((slide, index) => (
            <div class="outdoor__slide" data-outdoor-slide>
              <img
                class="outdoor__img"
                src={slide.src}
                alt=""
                decoding="async"
                fetchpriority={index === 0 ? 'high' : undefined}
              />
            </div>
          ))}
        </div>
      </div>
    )
  }

  <div class="container hero__inner">
    <div class="hero__content">
      <div class="hero__brand" data-anim="hero">
        <Logo />
      </div>

      <div class="hero__headline">
        <h1 class="title-lg" data-anim="hero">
          <span class="eyebrow hero__kicker">Fábrica de fardamentos no Paulista – PE</span>{' '}
          Padrão e qualidade<br />para o seu fardamento
        </h1>
        <p class="hero__slogan" data-anim="hero">{brand.slogan}</p>
      </div>

      <p class="lead hero__text" data-anim="hero">
        Fardamento escolar e operacional, polo, camisa promocional, bata, avental, camisa UV,
        brinde <strong class="hero__more">e muito mais</strong> — com acabamento conferido peça
        por peça.
      </p>

      <div class="hero__actions" data-anim="hero">
        <a href="#contato" class="btn btn--primary">
          Faça seu orçamento
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path>
          </svg>
        </a>
        <a href={whatsappUrl} class="btn btn--ghost" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15.5v3a2 2 0 0 1-2.2 2 19.5 19.5 0 0 1-8.5-3 19 19 0 0 1-6-6 19.5 19.5 0 0 1-3-8.6A2 2 0 0 1 3.3 1h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L7.2 9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2z"></path>
          </svg>
          Fale agora com um consultor
        </a>
      </div>
    </div>

    {
      /* A legenda do fundo: o recado da imagem da vez e a régua do tempo. Os
         recados ficam empilhados na mesma célula, então a altura é a do maior
         e a página não pula a cada troca. Um recado por imagem, na mesma
         ordem — vazio quando a imagem não tem —, porque é pela posição que a
         passagem acha o recado da imagem que entrou. */
      hasLegend && (
        <div class="hero__legend" data-anim="hero" aria-hidden="true">
          <div class="hero__promos">
            {heroSlides.map((slide) => (
              <div class="promo" data-outdoor-promo>
                {slide.promo?.badge && <span class="promo__badge">{slide.promo.badge}</span>}
                {slide.promo && <p class="promo__title">{slide.promo.title}</p>}
                {slide.promo?.text && <p class="promo__text">{slide.promo.text}</p>}
              </div>
            ))}
          </div>

          {/* Enche enquanto a imagem da vez espera a sua hora. Só aparece com
              JavaScript: sem ele não há troca, e uma régua parada mentiria. */}
          <div class="outdoor__timer">
            <span class="outdoor__timer-fill" data-outdoor-timer></span>
          </div>
        </div>
      )
    }

    <ul class="hero__stats" data-anim="hero">
      {heroStats.map((stat) => (
        <li class="stat">
          {stat.number && (
            <span class="stat__value">
              {/* O número de verdade, para leitor de tela e para o texto copiado. */}
              <span class="visually-hidden">{stat.number}{stat.suffix}</span>

              <span class="stat__odometer" aria-hidden="true">
                {stat.number.split('').map((digit) => (
                  <span class="reel">
                    <span class="reel__strip" style={`--digit:${digit}`} data-reel={digit}>
                      {REEL.map((value) => (
                        <span class="reel__digit">{value}</span>
                      ))}
                    </span>
                  </span>
                ))}
              </span>

              {stat.suffix && <span aria-hidden="true">{stat.suffix}</span>}
            </span>
          )}
          <span class="stat__text">{stat.text}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* No celular a logo abre a página sozinha, centrada, e o espaço acima dela
     é igual ao espaço abaixo: com 80px em cima e 42px embaixo, a marca lia
     como caída para o texto, e não como a abertura da página. Os dois lados
     usam o --section-pad. Embaixo, ele é a margem da marca somada ao gap dos
     blocos do hero, por isso o gap vira variável. */
  .hero {
    padding-block: var(--section-pad);
    background: var(--surface);
  }

  /* ---- Fundo ------------------------------------------------------- *
     As imagens ocupam a seção inteira, de borda a borda da tela, e ficam na
     camada mais baixa: a seção já é um contexto de empilhamento próprio
     (`.frestas`, com `isolation`), e as frestas estão em -1, então o fundo
     em -2 passa por trás delas. A ordem é fundo da seção → imagens → frestas
     → conteúdo. */
  /* O pé do fundo se dissolve na seção seguinte: cortada reto, a imagem
     terminava numa linha dura contra o branco das técnicas. Vale nos dois
     temas, e é por isso que mora aqui, e não na máscara do .outdoor, que o
     escuro desliga. */
  .hero__backdrop {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(180deg, #000 calc(100% - 160px), transparent);
    mask-image: linear-gradient(180deg, #000 calc(100% - 160px), transparent);
  }

  /* A opacidade baixa é o que deixa o texto por cima legível sem véu nem
     sombra: a imagem vira textura, e o título e os botões continuam com o
     contraste do fundo da página. Ela mora aqui, e não no invólucro, porque o
     invólucro é quem a entrada do GSAP leva de 0 a 1 — se fosse nele, a
     animação apagaria o esmaecimento ao terminar.

     No claro, 20% ainda é demais atrás do texto: sobre o cinza que uma foto
     escura vira, o laranja do slogan cai para ~2,2:1, abaixo dos 3:1 que
     texto grande pede (sobre o branco puro ele já fica em 3,5:1). A máscara
     tira a força da imagem só onde há texto — fica com 30% dela, ou ~6% no
     total — e a devolve inteira onde não há. No celular o texto ocupa a
     largura toda, então a imagem fica forte em cima, atrás da logo, e
     esmaece a partir da linha de cima do título. */
  .outdoor {
    position: absolute;
    inset: 0;
    opacity: 0.2;
    -webkit-mask-image: linear-gradient(180deg, #000 0, #000 110px, rgb(0 0 0 / 30%) 210px);
    mask-image: linear-gradient(180deg, #000 0, #000 110px, rgb(0 0 0 / 30%) 210px);
  }

  /* No escuro a mesma dose acende demais — as áreas claras das fotos viram
     uma névoa cinza sobre o fundo —, e a máscara sobra: texto claro sobre a
     foto escurecida já tem contraste de sobra. */
  :global(html[data-theme='dark']) .outdoor {
    opacity: 0.14;
    -webkit-mask-image: none;
    mask-image: none;
  }

  .outdoor__slide {
    position: absolute;
    inset: 0;
  }

  /* Sem JavaScript, ou com "reduzir movimento", o fundo para na primeira
     imagem em vez de mostrar todas empilhadas. */
  .outdoor__slide + .outdoor__slide {
    opacity: 0;
  }

  /* O fundo é bem mais largo que alto, então a imagem é cortada para
     preenchê-lo: o que fica é a faixa do meio dela. */
  .outdoor__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__inner {
    display: grid;
    gap: 40px;
    align-items: center;
  }

  .hero__content {
    --hero-gap: 26px;

    display: flex;
    flex-direction: column;
    gap: var(--hero-gap);
  }

  /* A marca abre a página em tamanho grande. Só a altura é definida; a
     largura sai da proporção do vetor, então o lockup nunca distorce.
     O piso de 100px é o que vale no celular: com 80px a logo ocupava só
     60% da tela e ficava tímida perto do título; com 100px ela abre a
     página com presença e os dois botões continuam na primeira tela. */
  .hero__brand {
    --logo-height: clamp(100px, 15vw, 140px);

    display: flex;
    align-items: center;
    /* No celular a marca abre a página sozinha: centralizada e com o mesmo
       espaço acima e abaixo dela. Encostada à esquerda e no mesmo gap dos
       outros blocos, o lockup deitado lia como mais uma linha de texto, e
       não como a abertura da página. A partir de 768px ela volta para a
       prumada do título, que é onde a coluna já é larga o bastante para a
       marca centralizada ficar boiando. */
    justify-content: center;
    margin-bottom: calc(var(--section-pad) - var(--hero-gap));
  }

  /* "e muito mais" fecha a lista de produtos: a enumeração é longa e mesmo
     assim não cabe tudo que a fábrica faz, então ela precisa dizer que não
     acaba ali. Ganha peso e o laranja de texto para ser lida como parte da
     lista, e não como reticência esquecida no fim da frase. */
  .hero__more {
    color: var(--accent);
    font-weight: 600;
  }

  .hero__headline {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* A linha de cima do título diz o que a Mirante é e onde fica. Ela mora
     dentro do <h1>, e não num parágrafo acima, porque é o título da página
     que o Google lê para entender o assunto — e ali faltava a cidade. */
  .hero__kicker {
    margin-bottom: 14px;
    letter-spacing: 0.12em;
  }

  .hero__slogan {
    font-family: var(--font-display);
    font-size: clamp(22px, 1.1rem + 2vw, 30px);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--accent);
  }

  /* Acompanha o corpo do .lead, que cresceu com os títulos: em 520px, "e muito
     mais" passava a quebrar no meio. */
  .hero__text {
    max-width: 580px;
  }

  /* Abaixo de 600px os dois não cabem lado a lado, e o segundo — mais largo —
     caía sozinho na linha de baixo, esticado na calha inteira: um degrau maior
     que o primeiro, como se a ação principal fosse ele. Empilhados e do mesmo
     tamanho, os dois voltam a ler como um par. */
  .hero__actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
  }

  .hero__actions .btn svg {
    width: 18px;
    height: 18px;
  }

  /* ---- Legenda do fundo -------------------------------------------- *
     O recado de cada imagem saiu de cima dela quando ela virou fundo: na
     opacidade do fundo ele ficaria ilegível. Aqui ele tem a cor de texto da
     página, e no celular vem logo abaixo dos botões. */
  .hero__legend {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  .hero__promos {
    display: grid;
  }

  .promo {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  /* Sem JavaScript, ou com "reduzir movimento", o fundo fica na primeira
     imagem, e a legenda mostra só o recado dela. */
  .promo + .promo {
    opacity: 0;
  }

  /* Texto escuro sobre a laranja da marca: branco sobre esse laranja não
     chega ao contraste mínimo. */
  .promo__badge {
    padding: 5px 12px;
    background: var(--orange-500);
    border-radius: var(--pill);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--on-accent);
  }

  .promo__title {
    font-size: clamp(20px, 1rem + 1vw, 30px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--heading);
  }

  .promo__text {
    font-size: clamp(15px, 0.9rem + 0.25vw, 18px);
    line-height: 1.5;
    color: var(--muted);
  }

  /* ---- Régua do tempo ---- */
  /* Nasce escondida e só aparece quando a passagem começa de fato: sem
     JavaScript, com "reduzir movimento" ou com uma imagem só, não há tempo
     a contar, e uma régua parada no zero prometeria um movimento que não
     vem. Quem a revela é o animations.ts. */
  .outdoor__timer {
    width: min(100%, 240px);
    height: 3px;
    overflow: hidden;
    background: var(--border);
    border-radius: 2px;
    visibility: hidden;
  }

  .outdoor__timer-fill {
    display: block;
    height: 100%;
    background: var(--orange-500);
    /* Nasce vazia e cresce por transform, nunca por largura: largura refaz o
       layout a cada quadro. */
    transform: scaleX(0);
    transform-origin: left center;
  }

  /* ---- Rodapé do hero ---------------------------------------------- */
  /* Linha de base comum: um item sem número, se voltar a existir, fica na
     mesma linha dos numerados em vez de flutuar acima deles. */
  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 16px 32px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .stat {
    display: flex;
    align-items: baseline;
    gap: 9px;
  }

  .stat__value {
    /* Altura de uma casa do rolo. Vale para a janela, para cada dígito e para
       o passo do giro — os três precisam bater, senão o número desalinha. */
    --reel-h: 1.15em;

    display: inline-flex;
    align-items: center;
    font-size: clamp(32px, 1.1rem + 2vw, 48px);
    font-weight: 700;
    letter-spacing: -0.02em;
    /* Sem largura tabular cada dígito ocupa um espaço diferente e o número
       treme na horizontal enquanto gira. */
    font-variant-numeric: tabular-nums;
    color: var(--heading);
  }

  .stat__odometer {
    display: inline-flex;
    /* Copiar a faixa deve levar "10+", não os vinte dígitos do rolo. */
    user-select: none;
  }

  .reel {
    display: block;
    width: 1ch;
    height: var(--reel-h);
    overflow: hidden;
  }

  /* Posição de repouso, a mesma que o GSAP escreve no fim: sem JS o número já
     nasce certo, em vez de mostrar o zero do começo do rolo. */
  .reel__strip {
    display: block;
    transform: translateY(calc((var(--digit) + 10) * var(--reel-h) * -1));
    /* A cor é declarada aqui, e não herdada: herdando, o Chromium não repinta
       a faixa quando o botão troca o tema com a página aberta, e os dígitos
       ficavam azul-marinho sobre o fundo escuro. */
    color: var(--heading);
  }

  .reel__digit {
    display: block;
    height: var(--reel-h);
    line-height: var(--reel-h);
    text-align: center;
  }

  .stat__text {
    font-size: 16px;
    line-height: 1.4;
    color: var(--muted);
  }

  @media (min-width: 600px) {
    .hero__actions {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
    }
  }

  @media (min-width: 768px) {
    /* Com a marca ao lado do título, o hero abre logo abaixo do cabeçalho
       sticky: um degrau a mais de folga no topo, e o --section-pad normal
       embaixo, que forma o encontro com a seção seguinte. */
    .hero {
      padding-top: calc(var(--section-pad) + var(--intro-gap));
    }

    /* Com mais folga no topo e a logo maior, o título desce, e o ponto em que
       a imagem esmaece desce junto. */
    .outdoor {
      -webkit-mask-image: linear-gradient(180deg, #000 0, #000 170px, rgb(0 0 0 / 30%) 260px);
      mask-image: linear-gradient(180deg, #000 0, #000 170px, rgb(0 0 0 / 30%) 260px);
    }

    .hero__brand {
      justify-content: flex-start;
      margin-bottom: 0;
    }

    .hero__stats {
      gap: 18px 48px;
    }
  }

  @media (min-width: 1080px) {
    /* A primeira tela é toda do hero, como na Masterboi: com o fundo de ponta
       a ponta, a seção seguinte aparecendo no pé da tela cortava o quadro ao
       meio. A conta desconta o cabeçalho sticky (76px no desktop) e a área
       segura do topo, que ele também ocupa. Em tela baixa o conteúdo é maior
       que isso e a altura volta a ser a dele. */
    .hero {
      display: flex;
      flex-direction: column;
      min-height: calc(100svh - 76px - env(safe-area-inset-top, 0px));
    }

    /* O texto fica na coluna da esquerda e a da direita é do fundo, com a
       legenda no pé dela, na altura dos botões. A sobra de altura vai para a
       primeira linha, então os números ficam sempre no rodapé da tela. */
    .hero__inner {
      flex: 1;
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      grid-template-rows: 1fr auto;
      column-gap: 72px;
      row-gap: 48px;
    }

    /* Lado a lado, o texto fica todo na coluna da esquerda: a imagem esmaece
       daquele lado e chega inteira na metade direita, onde só há a legenda. */
    .outdoor {
      -webkit-mask-image: linear-gradient(90deg, rgb(0 0 0 / 30%) 0%, rgb(0 0 0 / 30%) 42%, #000 72%);
      mask-image: linear-gradient(90deg, rgb(0 0 0 / 30%) 0%, rgb(0 0 0 / 30%) 42%, #000 72%);
    }

    .hero__content {
      gap: 30px;
    }

    .hero__legend {
      grid-column: 2;
      grid-row: 1;
      align-self: end;
      justify-self: end;
      align-items: flex-end;
      text-align: right;
    }

    .promo {
      align-items: flex-end;
    }

    /* A faixa é o rodapé do hero inteiro, não da coluna de texto: a régua
       atravessa as duas colunas, então os itens se espalham por baixo dela em
       vez de ficarem amontoados num canto. */
    .hero__stats {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-content: space-between;
      gap: 20px 48px;
      padding-top: 30px;
    }
  }
</style>
