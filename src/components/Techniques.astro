---
import { techniques } from '../data/site';

/**
 * As três técnicas, cada uma com o gesto da própria estamparia.
 *
 * O truque das animações é o mesmo em todas: o palco já nasce com a palavra
 * pronta e uma cobertura da cor do palco por cima. A cobertura desliza para a
 * direita e, enquanto isso, o conteúdo dentro dela desliza para a esquerda na
 * mesma velocidade — assim a palavra "por fazer" parece parada e só a boca da
 * cobertura se move, revelando a palavra pronta. Tudo em `transform`, sem
 * animar cor, largura ou clip.
 *
 * A coreografia fica em `src/scripts/animations.ts`; aqui só ficam as peças.
 */
---

<section class="techniques frestas frestas--left" id="tecnicas">
  <div class="container techniques__inner">
    <div class="techniques__intro" data-tech-intro>
      <span class="eyebrow" data-anim="up">Estampa e bordado</span>
      <h2 class="title-md" data-anim="up">Qual técnica você quer no seu <span class="highlight">padrão</span>?</h2>
      <p class="lead" data-anim="up">
        A técnica muda conforme o tecido e o desenho da arte — a gente indica a que segura melhor
        na peça.
      </p>
    </div>

    <ul class="techniques__list">
      {
        techniques.map((technique) => (
          <li class="tech" data-tech={technique.key} data-anim="point">
            <div class="tech__stage">
              {/* Camada de baixo: o resultado. É ela que fica no fim — e a que
                  aparece sozinha se o JavaScript não rodar. */}
              <h3 class="tech__word tech__lettering">{technique.name}</h3>

              {technique.key === 'bordado' && (
                <span class="tech__stitch" aria-hidden="true" />
              )}

              <div class="tech__wipe" aria-hidden="true" data-tech-wipe>
                <div class="tech__wipe-inner" data-tech-wipe-inner>
                  <span class="tech__lettering tech__ghost">{technique.name}</span>
                </div>
              </div>

              {/* O vapor sobe do que já foi prensado, então vem depois da
                  cobertura: fica por cima dela, e não é cortado na passagem. */}
              {technique.key === 'sublimacao' && (
                <span class="tech__vapor" aria-hidden="true">
                  <i data-tech-vapor />
                  <i data-tech-vapor />
                  <i data-tech-vapor />
                </span>
              )}

              {/* Trilho da ferramenta: anda junto com a cobertura, mas fora
                  dela, para a agulha, o rodo e o cilindro poderem passar da
                  borda. */}
              <div class="tech__rail" aria-hidden="true" data-tech-rail>
                {technique.key === 'bordado' && (
                  <svg class="tech__needle" viewBox="0 0 44 72" fill="none" data-tech-tool>
                    <path
                      class="tech__thread"
                      d="M33 7c-7.5 3.4-11 9-7.4 13.6"
                      stroke-width="2.6"
                      stroke-linecap="round"
                    />
                    <path class="tech__pin" d="M10 62 31 13" stroke-width="3.4" stroke-linecap="round" />
                    <ellipse
                      class="tech__eye"
                      cx="29.4"
                      cy="17.4"
                      rx="1.5"
                      ry="3.1"
                      transform="rotate(23 29.4 17.4)"
                      stroke-width="1.3"
                    />
                  </svg>
                )}

                {technique.key === 'serigrafia' && (
                  <svg class="tech__squeegee" viewBox="0 0 34 104" fill="none" data-tech-tool>
                    <rect class="tech__handle" x="11" y="2" width="12" height="62" rx="6" />
                    <path class="tech__blade" d="M3 60h28l-5 42H8z" />
                  </svg>
                )}

                {/* O cilindro da calandra: a prensa de sublimação que passa por
                    cima do tecido, em vez da chapa que desce. É ele que
                    justifica a passagem da esquerda para a direita. */}
                {technique.key === 'sublimacao' && (
                  <svg class="tech__roller" viewBox="0 0 34 104" fill="none" data-tech-tool>
                    <rect class="tech__roller-body" x="4" y="4" width="26" height="96" rx="13" />
                    <rect class="tech__roller-core" x="12" y="20" width="10" height="64" rx="5" />
                  </svg>
                )}
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .techniques {
    padding-block: var(--section-pad);
    background: var(--surface);
  }

  .techniques__intro {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 700px;
    margin-bottom: var(--intro-gap);
  }

  /* As três empilhadas, sempre. No desktop elas ocupam a coluna da esquerda e
     o texto de abertura vai para a direita, sem mudar a ordem do HTML —
     no celular a abertura continua vindo antes. */
  .techniques__list {
    display: grid;
    gap: 20px;
  }

  /* A palavra é medida contra a largura do card (cqi), não a da janela: em
     três colunas o card encolhe antes da janela, e "Sublimação" estouraria. */
  .tech {
    container-type: inline-size;

    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* ---------- O palco ---------- */

  .tech__stage {
    position: relative;
    height: 108px;
    overflow: hidden;
    background: var(--surface-2);
    border-radius: var(--radius-md);
  }

  /* A tela da serigrafia: a trama fica no palco, parada. */
  [data-tech='serigrafia'] .tech__stage,
  [data-tech='serigrafia'] .tech__wipe-inner {
    background-image: radial-gradient(circle, rgb(10 44 133 / 11%) 1.1px, transparent 1.2px);
    background-size: 7px 7px;
  }

  /* A trama é navy sobre claro; no escuro ela precisa ser a luz que atravessa. */
  :global(html[data-theme='dark']) [data-tech='serigrafia'] .tech__stage,
  :global(html[data-theme='dark']) [data-tech='serigrafia'] .tech__wipe-inner {
    background-image: radial-gradient(circle, rgb(255 255 255 / 13%) 1.1px, transparent 1.2px);
  }

  /* As duas palavras — a pronta e a "por fazer" — usam a mesma caixa e as
     mesmas medidas, então caem exatamente uma sobre a outra. */
  .tech__lettering {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: 12px;
    font-family: var(--font-display);
    font-size: clamp(30px, 9cqi, 56px);
    line-height: 1;
    letter-spacing: -0.02em;
    text-align: center;
    white-space: nowrap;
  }

  .tech__word {
    color: var(--heading);
  }

  /* A sublimação leva a cor para dentro da malha — a palavra fecha em degradê. */
  [data-tech='sublimacao'] .tech__word {
    background-image: linear-gradient(96deg, var(--blue-700) 18%, var(--orange-500) 96%);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  /* No escuro a ponta azul do degradê sumiria no palco: ela clareia. */
  :global(html[data-theme='dark']) [data-tech='sublimacao'] .tech__word {
    background-image: linear-gradient(96deg, #7ba0ff 18%, var(--orange-500) 96%);
  }

  .tech__ghost {
    color: var(--border-strong);
  }


  /* O caminho da linha, abaixo da palavra. Os tracinhos são o ponto. */
  .tech__stitch {
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: 20px;
    height: 3px;
    background-image: repeating-linear-gradient(
      90deg,
      var(--orange-500) 0 9px,
      transparent 9px 17px
    );
    border-radius: 2px;
  }

  /* ---------- Cobertura e trilho ---------- */

  .tech__wipe {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--surface-2);
    /* Estado final: fora do palco. O estado inicial só entra com JS ativo. */
    transform: translateX(100%);
  }

  .tech__wipe-inner {
    position: absolute;
    inset: 0;
    transform: translateX(-100%);
  }

  .tech__rail {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }

  :global(.js-anim) .tech__wipe {
    transform: translateX(0);
  }

  :global(.js-anim) .tech__wipe-inner {
    transform: translateX(0);
  }

  /* ---------- Ferramentas ---------- */

  .tech__needle,
  .tech__squeegee {
    position: absolute;
    left: 0;
  }

  /* A ponta da agulha cai em cima da linha de pontos — é dela que os pontos
     estão saindo. Por isso a agulha se prende ao pé do palco, não ao meio. */
  .tech__needle {
    bottom: 16px;
    width: 30px;
    height: 49px;
    margin-left: -15px;
  }

  /* O rodo acompanha a altura do palco, como acompanharia a da tela. */
  .tech__squeegee {
    top: 11%;
    height: 78%;
    width: auto;
    transform: translateX(-50%) rotate(-7deg);
  }

  .tech__thread {
    stroke: var(--orange-500);
  }

  .tech__pin {
    stroke: var(--heading);
  }

  .tech__eye {
    stroke: var(--surface);
  }

  .tech__handle {
    fill: var(--heading);
  }

  .tech__blade {
    fill: var(--orange-500);
  }

  /* O cilindro da calandra acompanha a altura do palco, como o rodo. */
  .tech__roller {
    position: absolute;
    left: 0;
    top: 8%;
    height: 84%;
    width: auto;
    transform: translateX(-50%);
  }

  .tech__roller-body {
    fill: var(--heading);
  }

  /* O miolo quente, que é o que transfere a cor para a malha. */
  .tech__roller-core {
    fill: var(--orange-500);
  }

  .tech__vapor {
    position: absolute;
    inset: 0;
  }

  .tech__vapor i {
    position: absolute;
    bottom: 16px;
    width: 16px;
    height: 22px;
    background: rgb(20 64 189 / 16%);
    border-radius: 60% 60% 45% 45%;
    opacity: 0;
  }

  :global(html[data-theme='dark']) .tech__vapor i {
    background: rgb(255 255 255 / 16%);
  }

  .tech__vapor i:nth-child(1) {
    left: 16%;
  }

  .tech__vapor i:nth-child(2) {
    left: 48%;
    width: 13px;
    height: 18px;
  }

  .tech__vapor i:nth-child(3) {
    left: 76%;
  }

  @media (min-width: 560px) {
    .tech__stage {
      height: 124px;
    }
  }

  @media (min-width: 1080px) {
    /* A abertura fica no topo, não centrada: a lista das três é bem mais alta
       que ela, e centrar empurrava a pergunta da seção para baixo da primeira
       palavra — quem rolava encontrava "Bordado" antes de saber o que a seção
       estava perguntando. */
    .techniques__inner {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: 64px;
      align-items: start;
    }

    /* A abertura vem antes no HTML e vai para a segunda coluna aqui. */
    .techniques__intro {
      grid-area: 1 / 2;
      margin-bottom: 0;
    }

    .techniques__list {
      grid-area: 1 / 1;
      gap: 24px;
    }

    .tech__stage {
      height: 144px;
    }
  }
</style>
