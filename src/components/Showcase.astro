---
import { fabrics, fabricsMore, fabricsNote, factoryPoints, productCategories } from '../data/site';

// Amostras do card "e muito mais": recortes redondos das fotos que já estão
// na grade, então não custam download a mais.
const swatches = fabrics.flatMap((fabric) => (fabric.photo ? [fabric.photo] : [])).slice(0, 4);

// A lista é duplicada para o trilho poder reiniciar sem salto visível.
const track = [...productCategories, ...productCategories];
---

<section class="showcase frestas" id="tecidos">
  <div class="container showcase__intro">
    <span class="eyebrow" data-anim="up">Tecidos e malhas</span>
    <h2 class="title-md showcase__title" data-anim="up">Qual <span class="highlight">tecido</span> a sua peça pede?</h2>
    <p class="lead" data-anim="up">
      Do piquet da polo ao brim do macacão, cada uso pede a sua malha. A gente indica a
      combinação certa junto com o orçamento.
    </p>
    <p class="showcase__note" data-anim="up">{fabricsNote}</p>
  </div>

  <div class="container">
    <ul class="fabrics">
      {fabrics.map((fabric) => (
        <li class="fabric" data-anim="point">
          {fabric.photo ? (
            <img
              class="fabric__photo"
              src={fabric.photo}
              alt={`Tecido ${fabric.name}`}
              loading="lazy"
              decoding="async"
              width="300"
              height="200"
            />
          ) : (
            <div class="photo-slot fabric__photo" aria-hidden="true"></div>
          )}
          <div class="fabric__body">
            <h3 class="fabric__name">{fabric.name}</h3>
            <p class="fabric__use">{fabric.use}</p>
          </div>
        </li>
      ))}
      <li class="fabric fabric--more" data-anim="point">
        <div class="fabric__photo fabric__swatches" aria-hidden="true">
          {swatches.map((photo) => (
            <span class="fabric__swatch" style={`background-image: url('${photo}')`}></span>
          ))}
          <span class="fabric__swatch fabric__swatch--plus">+</span>
        </div>
        <div class="fabric__body">
          <h3 class="fabric__name">{fabricsMore.name}</h3>
          <p class="fabric__use">{fabricsMore.use}</p>
        </div>
      </li>
    </ul>

    <ul class="quality">
      {factoryPoints.map((point) => (
        <li class="quality__item" data-anim="point">
          <span class="quality__check" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="m4 12.5 5 5 11-11"></path>
            </svg>
          </span>
          {point}
        </li>
      ))}
    </ul>

    <h3 class="showcase__sub" id="segmentos" data-anim="up">Segmentos</h3>
  </div>

  <div class="marquee marquee--drag" data-marquee="ltr" data-marquee-drag>
    <ul class="marquee__track" data-marquee-track>
      {track.map((category, index) => (
        <li class="product card" aria-hidden={index >= productCategories.length ? 'true' : undefined}>
          {category.photo ? (
            <img class="product__photo" src={category.photo} alt={category.name} loading="lazy" decoding="async" width="292" height="224" />
          ) : (
            <div class="photo-slot product__photo" aria-hidden="true"></div>
          )}
          <div class="product__body">
            <h4 class="product__name">{category.name}</h4>
            <p class="product__text">{category.description}</p>
          </div>
        </li>
      ))}
    </ul>

    <!-- Só aparecem com JavaScript e com mouse: no toque quem passa é o dedo. -->
    <button type="button" class="marquee__step marquee__step--prev" aria-label="Ver categorias anteriores" data-marquee-step="prev">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 5l-7 7 7 7"></path>
      </svg>
    </button>
    <button type="button" class="marquee__step marquee__step--next" aria-label="Ver próximas categorias" data-marquee-step="next">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 5l7 7-7 7"></path>
      </svg>
    </button>
  </div>
</section>

<style>
  .showcase {
    padding-block: var(--section-pad);
    background: var(--surface);
    overflow: hidden;
  }

  /* A abertura é centrada: o título é o ponto alto da seção e o texto abaixo
     fica numa coluna estreita, que não se espalha pela largura da página. */
  .showcase__intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    text-align: center;
    margin-bottom: var(--intro-gap);
  }

  .showcase__intro .lead {
    max-width: 560px;
    text-wrap: balance;
  }

  /* Maior que os outros títulos de seção, e numa linha só a partir do
     tablet: a frase cabe inteira, e quebrada em duas ela perdia a força. No
     celular não cabe, e quebra equilibrada e centrada. */
  .showcase__title {
    font-size: clamp(28px, 5.4vw, 64px);
  }

  @media (min-width: 768px) {
    .showcase__title {
      white-space: nowrap;
    }
  }

  /* O padrão da matéria-prima. Uma linha, sem caixa: como bloco de texto ela
     virava caixa de dica e o visitante pulava. O traço laranja dá o destaque
     sem precisar de fundo nem de marcação dentro do conteúdo. */
  .showcase__note {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--ink);
  }

  .showcase__note::before {
    content: '';
    display: inline-block;
    width: 18px;
    height: 3px;
    margin-right: 10px;
    vertical-align: middle;
    background: var(--accent);
    border-radius: 2px;
  }

  /* Flex em vez de grid para a última fileira ficar centrada em vez de deixar
     um buraco na ponta, qualquer que seja o número de tecidos. A largura do
     card é calculada por breakpoint, então todos ficam do mesmo tamanho. */
  .fabrics {
    --fabric-gap: 14px;

    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--fabric-gap);
  }

  .fabric {
    flex: 0 1 100%;
    overflow: hidden;
    background: var(--surface-2);
    border-radius: var(--radius-sm);
  }

  .fabric__photo {
    width: 100%;
    height: 132px;
    object-fit: cover;
  }

  .fabric__body {
    padding: 16px 18px 18px;
  }

  .fabric__name {
    margin-bottom: 6px;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .fabric__use {
    font-size: 15px;
    line-height: 1.5;
    color: var(--muted-2);
  }

  /* ---- "E muito mais" ---- */
  /* Fecha a grade no mesmo formato dos outros cards, mas no lugar da foto
     traz um leque de amostras sobrepostas: é a variedade dita pela imagem,
     e o "+" no fim do leque diz que ele continua. */
  .fabric--more .fabric__name {
    color: var(--accent);
  }

  .fabric__swatches {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent-wash);
  }

  .fabric__swatch {
    width: 58px;
    height: 58px;
    margin-left: -14px;
    background-color: var(--surface-3);
    background-position: center;
    background-size: cover;
    border: 3px solid var(--accent-wash);
    border-radius: 50%;
  }

  .fabric__swatch:first-child {
    margin-left: 0;
  }

  .fabric__swatch--plus {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--orange-500);
    color: var(--on-accent);
    font-size: 26px;
    font-weight: 700;
    line-height: 1;
  }

  /* Os pontos de qualidade que vinham da seção "A fábrica". A distância até a
     grade de tecidos precisa ser bem maior que a distância entre os próprios
     pontos: com os dois saltos parecidos, as quatro linhas colavam nos cards
     e liam como legenda deles, não como uma lista de outra natureza. */
  .quality {
    display: grid;
    gap: 14px;
    margin-top: calc(var(--intro-gap) * 1.5);
  }

  .quality__item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink);
  }

  .quality__check {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background: var(--accent-wash);
    border-radius: var(--pill);
    color: var(--accent);
    flex-shrink: 0;
  }

  .quality__check svg {
    width: 14px;
    height: 14px;
  }

  /* "Segmentos" abre um bloco novo dentro da mesma seção,
     então tem o maior salto interno da seção: acima dele a escada é 14px entre
     os pontos e 1,5 × --intro-gap da grade para os pontos, e um bloco novo só
     se anuncia se o salto dele for maior que os dois. Ainda assim fica abaixo
     de --section-y, que é o encontro de duas seções de verdade. */
  .showcase__sub {
    margin-top: calc(var(--intro-gap) * 2.5);
    margin-bottom: 20px;
    font-size: clamp(22px, 1rem + 1.6vw, 32px);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  /* Clipa só na horizontal: `overflow: hidden` cortava a sombra dos cards a
     8px do rodapé deles, e o corte reto atravessando a página inteira lia
     como uma linha de emenda entre as seções. `clip` é o único valor que o
     outro eixo aceita ao lado de `visible`, então é ele que deixa a sombra
     transbordar para o respiro da seção. */
  .marquee {
    position: relative;
    padding-block: 8px;
    overflow-x: clip;
    overflow-y: visible;
  }

  /* A esteira das categorias é conduzida pelo visitante: arrastar move o
     trilho junto com o dedo. `pan-y` deixa a rolagem vertical da página
     passar, então só o gesto horizontal vira arrasto. */
  .marquee--drag {
    cursor: grab;
    touch-action: pan-y;
  }

  .marquee--drag.is-dragging {
    cursor: grabbing;
  }

  .marquee--drag .marquee__track {
    user-select: none;
  }

  .marquee--drag img {
    -webkit-user-drag: none;
  }

  .marquee__step {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: var(--card);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    box-shadow: var(--shadow-card);
    color: var(--heading);
    cursor: pointer;
    transform: translateY(-50%);
    transition:
      border-color 0.18s ease,
      color 0.18s ease;
  }

  /* Só com JavaScript (sem ele não há o que empurrar) e só com mouse:
     no toque o próprio dedo já faz o papel dos botões. */
  @media (pointer: fine) {
    :global(html.js) .marquee__step {
      display: inline-flex;
    }
  }

  .marquee__step:hover {
    border-color: var(--heading);
    color: var(--accent);
  }

  .marquee__step svg {
    width: 22px;
    height: 22px;
  }

  .marquee__step--prev {
    left: 8px;
  }

  .marquee__step--next {
    right: 8px;
  }

  .marquee__track {
    display: flex;
    gap: 16px;
    width: max-content;
    will-change: transform;
  }

  .product {
    display: flex;
    flex-direction: column;
    width: 232px;
    overflow: hidden;
  }

  .product__photo {
    height: 176px;
    border-radius: 0;
    object-fit: cover;
    width: 100%;
  }

  .product__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px;
  }

  /* h4 não entra na regra de cor dos títulos em global.css, então a cor da
     marca vem daqui — os cards continuam iguais aos de antes. */
  .product__name {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--heading);
  }

  .product__text {
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted-2);
  }

  @media (min-width: 560px) {
    .fabric {
      flex-basis: calc((100% - var(--fabric-gap)) / 2);
    }

    .quality {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px 28px;
    }
  }

  @media (min-width: 768px) {
    .fabric {
      flex-basis: calc((100% - var(--fabric-gap) * 2) / 3);
    }

    .marquee__track {
      gap: 24px;
    }

    .product {
      width: 292px;
    }

    .product__photo {
      height: 224px;
    }

    .product__name {
      font-size: 19px;
    }

    .product__body {
      padding: 24px;
    }
  }

  @media (min-width: 1080px) {
    .fabrics {
      --fabric-gap: 16px;
    }

    .fabric {
      flex-basis: calc((100% - var(--fabric-gap) * 3) / 4);
    }

    .fabric__photo {
      height: 148px;
    }

    .quality {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .showcase__sub {
      margin-bottom: 24px;
    }
  }
</style>
