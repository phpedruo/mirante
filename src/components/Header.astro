---
import Logo from './Logo.astro';

// Os links levam `/` na frente para funcionar também fora da página inicial,
// como na 404 — ali, `#tecidos` sozinho apontaria para a própria página de erro.
// "Segmentos" leva ao meio da seção de tecidos, onde começa a esteira das
// categorias.
const links = [
  { href: '/#tecidos', label: 'Tecidos' },
  { href: '/#segmentos', label: 'Segmentos' },
  { href: '/#clientes', label: 'Confiança de grandes' },
  { href: '/#duvidas', label: 'Dúvidas' },
  { href: '/#localizacao', label: 'Localização' },
];
---

<header class="site-header" data-header>
  {/* A costura: uma linha reta de pontos na base da faixa, como o pesponto
      da barra de uma camisa, e uma agulha que corre por ela sem parar, com um
      trecho aceso de linha atrás. A linha é só CSS e aparece mesmo sem
      JavaScript; a agulha e o trecho aceso são do animations.ts. */}
  <div class="nav-thread" aria-hidden="true" data-nav-thread>
    <span class="nav-thread__stitch"></span>
    <div class="nav-thread__trail" data-nav-thread-trail>
      <div class="nav-thread__trail-inner" data-nav-thread-trail-inner>
        <span class="nav-thread__stitch nav-thread__stitch--lit"></span>
      </div>
    </div>
    <svg class="nav-thread__needle" viewBox="0 0 24 8" data-nav-thread-needle>
      <path class="nav-thread__pin" d="M4.6 2.5H17L23.5 4 17 5.5H4.6a1.5 1.5 0 0 1 0-3z" />
      <ellipse class="nav-thread__eye" cx="5.2" cy="4" rx="1.6" ry="0.55" />
    </svg>
  </div>

  <div class="container site-header__inner">
    <a href="/#topo" class="site-header__brand" aria-label="Mirante Camisas e Fardamentos">
      <Logo aguia />
    </a>

    <nav class="site-header__nav" id="nav-principal" aria-label="Navegação principal">
      <ul>
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
      <a href="/#contato" class="btn btn--accent site-header__cta-mobile">Faça seu orçamento</a>
    </nav>

    <div class="site-header__actions">
      <!-- Só aparece com JavaScript: sem ele o botão não teria o que fazer. -->
      <button type="button" class="theme-toggle" aria-label="Alternar modo escuro" aria-pressed="false" data-theme-toggle>
        <svg class="theme-toggle__icon theme-toggle__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5a8.6 8.6 0 1 0 11.1 11.1z"></path>
        </svg>
        <svg class="theme-toggle__icon theme-toggle__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2"></circle>
          <path d="M12 2.7v2.1"></path><path d="M12 19.2v2.1"></path>
          <path d="M4.9 4.9l1.5 1.5"></path><path d="M17.6 17.6l1.5 1.5"></path>
          <path d="M2.7 12h2.1"></path><path d="M19.2 12h2.1"></path>
          <path d="M4.9 19.1l1.5-1.5"></path><path d="M17.6 6.4l1.5-1.5"></path>
        </svg>
      </button>

      <a href="/#contato" class="btn btn--accent site-header__cta">Faça seu orçamento</a>
      <button
        type="button"
        class="site-header__toggle"
        aria-expanded="false"
        aria-controls="nav-principal"
        data-nav-toggle
       
      >
        <span class="visually-hidden">Abrir menu</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16"></path><path d="M4 12h16"></path><path d="M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  /* A faixa é azul nos dois temas, no azul literal do logo, e não no
     --brand-fill, que clareia no escuro: ela tem que ser a mesma cor da
     theme-color do <head>, que o navegador usa para pintar a barra de status
     e a de endereço, e que não acompanha o tema. Com as duas diferentes, o
     topo da tela abriria com duas faixas de azul. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    /* Com viewport-fit=cover (Base.astro), a página começa atrás do notch e
       da barra de status: o azul preenche essa área e o conteúdo desce o
       tanto da área segura, para não ficar embaixo deles. Sem notch, ela é
       zero e nada muda. */
    padding-top: env(safe-area-inset-top, 0px);
    background: var(--blue-900);
    transition: box-shadow 0.2s ease;
  }

  /* ---- Costura ---------------------------------------------------- *
     Fica atrás das opções, na camada logo acima do azul da faixa (o
     cabeçalho já é um contexto de empilhamento, pelo sticky com z-index).
     Começa abaixo da área segura, onde a faixa de fato começa. */
  .nav-thread {
    --stitch-h: 4px;
    --stitch-bottom: 4px;

    position: absolute;
    z-index: -1;
    top: env(safe-area-inset-top, 0px);
    right: 0;
    bottom: 0;
    left: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* Os pontos da costura, como a linha do bordado na seção de técnicas, só
     que mais grossos. A linha inteira fica sempre à vista, apagada; o trecho
     que acabou de passar pela agulha é a mesma linha, acesa. As duas começam
     no mesmo x, então os pontos de uma caem exatamente sobre os da outra. */
  .nav-thread__stitch {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--stitch-bottom);
    height: var(--stitch-h);
    background-image: repeating-linear-gradient(
      90deg,
      var(--orange-500) 0 12px,
      transparent 12px 20px
    );
    border-radius: 2px;
    opacity: 0.4;
  }

  .nav-thread__stitch--lit {
    opacity: 1;
  }

  /* O trecho aceso é uma janela que corre pela faixa enquanto a linha dentro
     dela corre para o lado contrário, na mesma medida: a linha fica parada e
     só a janela anda — o mesmo par das técnicas, e só com transform. A cauda
     se apaga aos poucos; a ponta, onde está a agulha, é nítida. Os dois e a
     agulha só aparecem quando a animação começa. */
  .nav-thread__trail,
  .nav-thread__needle {
    position: absolute;
    left: 0;
    visibility: hidden;
  }

  .nav-thread__trail {
    top: 0;
    bottom: 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 75%);
    mask-image: linear-gradient(90deg, transparent, #000 75%);
  }

  .nav-thread__trail-inner {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
  }

  /* A agulha deitada sobre a costura, com o olho no meio da linha: é do olho
     que a linha sai, e é ele que fica na ponta do trecho aceso. */
  .nav-thread__needle {
    bottom: calc(var(--stitch-bottom) + var(--stitch-h) / 2 - 5px);
    width: 30px;
    height: 10px;
    overflow: visible;
  }

  .nav-thread__pin {
    fill: #fff;
  }

  .nav-thread__eye {
    fill: var(--blue-900);
  }

  /* No celular a faixa é mais baixa e os botões quase encostam na base: a
     costura afina e desce um pouco para não colar neles. */
  @media (max-width: 1079px) {
    .nav-thread {
      --stitch-h: 3px;
      --stitch-bottom: 3px;
    }
  }

  .site-header[data-scrolled] {
    box-shadow: 0 1px 16px rgb(16 26 53 / 8%);
  }

  /* Sombra navy sobre fundo escuro não se vê; só preto ainda separa a faixa. */
  :global(html[data-theme='dark']) .site-header[data-scrolled] {
    box-shadow: 0 1px 16px rgb(0 0 0 / 55%);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 68px;
  }

  /* Flex para a águia não ficar sobre uma linha de texto: como inline, ela
     ganhava embaixo a folga das letras que descem da linha e subia 5px na
     faixa. */
  .site-header__brand {
    --logo-height: 40px;

    display: flex;
  }

  .site-header__brand:hover {
    color: inherit;
  }

  .site-header__nav ul {
    display: flex;
    align-items: center;
    gap: 34px;
  }

  /* Na fonte do slogan: na Archivo comum, os links ficavam apagados na faixa.
     O seletor pega só os links da lista: o botão "Faça seu orçamento" do menu
     no celular também é um <a> dentro da navegação, e com o seletor amplo ele
     herdaria a cor e o sublinhado dos links. */
  .site-header__nav li a {
    position: relative;
    font-family: var(--font-display);
    font-size: 15px;
    color: #fff;
  }

  /* O sublinhado é uma linha própria, e não um text-decoration, porque ele
     precisa ter direção: no hover ela nasce encolhida na esquerda e cresce
     até o fim do link, e ao sair volta para a esquerda. Só `transform`. */
  .site-header__nav li a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 2px;
    background: var(--orange-500);
    border-radius: 1px;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.28s ease;
  }

  .site-header__nav li a:hover,
  .site-header__nav li a:focus-visible {
    color: #fff;
  }

  .site-header__nav li a:hover::after,
  .site-header__nav li a:focus-visible::after {
    transform: scaleX(1);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* Os dois botões de ícone, o do tema e o do menu: sobre o azul, contorno
     claro e ícone branco. */
  .theme-toggle,
  .site-header__toggle {
    align-items: center;
    justify-content: center;
    padding: 0;
    background: transparent;
    border: 1px solid rgb(255 255 255 / 35%);
    border-radius: var(--radius-sm);
    color: #fff;
    cursor: pointer;
    transition: border-color 0.18s ease, background-color 0.18s ease;
  }

  /* Só com mouse: no toque o hover gruda no botão depois do toque, e o do
     menu ficava aceso depois de fechado. */
  @media (hover: hover) {
    .theme-toggle:hover,
    .site-header__toggle:hover {
      border-color: #fff;
      background: rgb(255 255 255 / 10%);
    }
  }

  .theme-toggle {
    display: none;
    width: 46px;
    height: 46px;
  }

  :global(html.js) .theme-toggle {
    display: inline-flex;
  }

  .theme-toggle__icon {
    width: 21px;
    height: 21px;
  }

  /* No claro o botão oferece a lua (o que ele vai ligar); no escuro, o sol. */
  .theme-toggle__sun {
    display: none;
  }

  :global(html[data-theme='dark']) .theme-toggle__sun {
    display: block;
  }

  :global(html[data-theme='dark']) .theme-toggle__moon {
    display: none;
  }

  .site-header__cta {
    min-height: 46px;
    padding-inline: 26px;
  }

  .site-header__cta-mobile {
    display: none;
  }

  .site-header__toggle {
    display: none;
    width: 48px;
    height: 48px;
  }

  .site-header__toggle svg {
    width: 22px;
    height: 22px;
  }

  /* Com cinco links na fonte do slogan, que é larga, a barra deitada só cabe
     a partir de 1200px: em 1080, "Confiança de grandes" e o botão de
     orçamento quebravam em duas linhas. Abaixo disso, o menu vira o painel do
     botão — o resto do layout de desktop continua começando em 1080. */
  @media (max-width: 1199px) {
    /* O painel do menu continua a faixa azul, separado dela só por um fio. */
    .site-header__nav {
      position: absolute;
      inset-inline: 0;
      top: 100%;
      display: none;
      flex-direction: column;
      gap: 8px;
      padding: 20px var(--gutter) 28px;
      background: var(--blue-900);
      border-top: 1px solid rgb(255 255 255 / 14%);
      box-shadow: 0 16px 32px rgb(16 26 53 / 10%);
    }

    :global(html[data-theme='dark']) .site-header__nav {
      box-shadow: 0 16px 32px rgb(0 0 0 / 55%);
    }

    .site-header__nav[data-open] {
      display: flex;
    }

    .site-header__nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .site-header__nav li + li {
      border-top: 1px solid rgb(255 255 255 / 14%);
    }

    .site-header__nav li a {
      display: block;
      padding: 15px 0;
      font-size: 17px;
    }

    /* No painel o link tem folga em cima e embaixo: a linha sobe para dentro
       dela, em vez de cair sobre o fio que separa os itens. */
    .site-header__nav li a::after {
      bottom: 9px;
    }

    .site-header__cta-mobile {
      display: inline-flex;
      margin-top: 12px;
    }

    .site-header__cta {
      display: none;
    }

    .site-header__toggle {
      display: inline-flex;
    }

    /* Alinha com o botão do menu, que é maior que o CTA do desktop. */
    .theme-toggle {
      width: 48px;
      height: 48px;
    }
  }

  @media (min-width: 1080px) {
    .site-header__inner {
      min-height: 76px;
    }

    .site-header__brand {
      --logo-height: 46px;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.getElementById('nav-principal');

  if (toggle && nav) {
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.toggleAttribute('data-open', open);
    };

    toggle.addEventListener('click', () => {
      setOpen(!isOpen());
    });

    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });

    // Tocar fora do painel fecha o menu. É `pointerdown`, e não `click`: o
    // Safari do iPhone nem sempre entrega ao documento o clique de um toque
    // em área sem nada clicável. O botão do menu fica fora da conta, porque
    // ele já alterna sozinho: contado como "fora", o toque fecharia o painel
    // só para o clique do botão reabrir em seguida.
    document.addEventListener('pointerdown', (event) => {
      const target = event.target as Node;
      if (isOpen() && !nav.contains(target) && !toggle.contains(target)) setOpen(false);
    });

    // Esc fecha também, e devolve o foco ao botão, de onde o teclado veio.
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });

    // Se a janela crescer até a barra deitada, o painel não pode ficar preso aberto.
    window.matchMedia('(min-width: 1200px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }

  // A escolha do tema é lida antes da primeira pintura pelo script inline do
  // Base.astro; aqui só ficam o clique e o que ele guarda.
  const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  if (themeToggle) {
    const root = document.documentElement;

    const syncToggle = () => {
      themeToggle.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
    };

    syncToggle();

    themeToggle.addEventListener('click', () => {
      root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';

      try {
        localStorage.setItem('mirante-tema', root.dataset.theme);
      } catch (error) {
        // Armazenamento bloqueado: a troca vale só para esta visita.
      }

      syncToggle();
    });
  }

  if (header) {
    const onScroll = () => {
      header.toggleAttribute('data-scrolled', window.scrollY > 8);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
